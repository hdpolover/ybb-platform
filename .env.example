# Environment
NODE_ENV=development
GO_ENV=development
PYTHON_ENV=development

# Database - PostgreSQL
DATABASE_URL=postgresql://ybb_user:ybb_password@postgres:5432/ybb_platform_db
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=ybb_user
DATABASE_PASSWORD=ybb_password
DATABASE_NAME=ybb_platform_db
DATABASE_URL_PAYMENT=postgresql://ybb_user:ybb_password@postgres:5432/ybb_payments_db
DATABASE_URL_FILE=postgresql://ybb_user:ybb_password@postgres:5432/ybb_files_db

#--------------------------------------------------------------------
# MIDTRANS PAYMENT GATEWAY
#--------------------------------------------------------------------
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SB_SERVER_KEY=
MIDTRANS_SB_CLIENT_KEY=
MIDTRANS_IS_SANITIZED=false
MIDTRANS_IS_3DS=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRATION=30d

# Service URLs (Internal)
API_GATEWAY_URL=http://api:4000
PAYMENT_SERVICE_URL=http://payment-service:8080
FILE_SERVICE_URL=http://file-service:8001
PAYMENT_SERVICE_URL=http://payment-service:8002
ADMIN_DASHBOARD_URL=http://admin-dashboard:4001

# Service URLs (External - for production)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_APP_URL=http://localhost

# MinIO / S3 Storage
MINIO_ENDPOINT=minio:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ybb-files
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false
MINIO_REGION=us-east-1

# AWS S3 (if using AWS instead of MinIO)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# Notification Service
RESEND_API_KEY=
RESEND_FROM=YBB Notifications <no-reply@notifications.ybbhub.com>

# Email Service (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@ybb-platform.com

# RabbitMQ (Optional - for message queue)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Monitoring (Optional)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Application
APP_NAME=YBB Platform
APP_VERSION=1.0.0

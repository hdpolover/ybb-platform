# ===========================================
# YBB Platform - Production Environment
# ===========================================
# Copy this file to .env on your VPS
# IMPORTANT: Replace ALL placeholder values!

# ===========================================
# Docker Hub (for pulling images)
# ===========================================
DOCKER_USERNAME=your-docker-username
IMAGE_TAG=latest

# ===========================================
# Database - PostgreSQL
# ===========================================
DATABASE_USER=ybb_prod_user
DATABASE_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
DATABASE_NAME=ybb_production
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_URL=postgresql://ybb_prod_user:CHANGE_THIS_STRONG_PASSWORD_123!@postgres:5432/ybb_production

# ===========================================
# Redis Cache
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_456!
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_456!@redis:6379

# ===========================================
# JWT Authentication
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_64_CHAR_RANDOM_STRING_USE_OPENSSL_RAND
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_64_CHAR_RANDOM_STRING
JWT_REFRESH_EXPIRATION=7d

# ===========================================
# MinIO / S3 Storage
# ===========================================
MINIO_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY_MAKE_IT_LONG
MINIO_BUCKET=ybb-files
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# ===========================================
# Service URLs (Public facing)
# ===========================================
# Replace with your actual domain
NEXT_PUBLIC_API_URL=https://api.ybbhub.com/api/v1
NEXT_PUBLIC_APP_URL=https://admin.ybbhub.com

# ===========================================
# Payment - Stripe (Production keys)
# ===========================================
STRIPE_SECRET_KEY=sk_live_your_stripe_live_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_live_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret
STRIPE_CURRENCY=usd

# ===========================================
# Email Service
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@yourdomain.com

# ===========================================
# CORS Origins (comma-separated)
# ===========================================
CORS_ORIGINS=https://ybbhub.com,https://admin.ybbhub.com,https://api.ybbhub.com,https://payment.ybbhub.com,https://notification.ybbhub.com,https://files.ybbhub.com

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# File Upload Limits
# ===========================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info
LOG_FORMAT=json

# ===========================================
# Application
# ===========================================
NODE_ENV=production
GO_ENV=production
PYTHON_ENV=production
APP_NAME=YBB Platform
APP_VERSION=1.0.0

# Kubernetes Secrets
# Note: This is a template file. Create actual secrets using:
# kubectl create secret generic ybb-secrets --from-literal=key=value -n ybb-platform

apiVersion: v1
kind: Secret
metadata:
  name: ybb-secrets
  namespace: ybb-platform
type: Opaque
stringData:
  DATABASE_URL: "postgresql://user:password@postgres:5432/ybb_db"
  JWT_SECRET: "your-jwt-secret"
  STRIPE_SECRET_KEY: "sk_test_..."
  REDIS_PASSWORD: "redis-password"

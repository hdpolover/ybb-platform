# ===========================================
# YBB Platform - Staging Environment
# ===========================================
# Copy this file to .env on your VPS for staging
# IMPORTANT: Replace ALL placeholder values!

# ===========================================
# Docker Hub (for pulling images)
# ===========================================
DOCKER_USERNAME=ybb-platform
IMAGE_TAG=staging

# ===========================================
# Database - PostgreSQL
# ===========================================
DATABASE_USER=ybb_staging_user
DATABASE_PASSWORD=S8k9V2m4N5q1W3e
DATABASE_NAME=ybb_staging_db
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_URL=postgresql://ybb_staging_user:S8k9V2m4N5q1W3e@postgres:5432/ybb_staging_db
DATABASE_URL_PAYMENT=postgresql://ybb_staging_user:S8k9V2m4N5q1W3e@postgres:5432/ybb_payments_db
DATABASE_URL_FILE=postgresql://ybb_staging_user:S8k9V2m4N5q1W3e@postgres:5432/ybb_files_db

# ===========================================
# Redis Cache
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=P3l7J9h2X1z5C8v
REDIS_URL=redis://:P3l7J9h2X1z5C8v@redis:6379

# ===========================================
# RabbitMQ
# ===========================================
RABBITMQ_USER=ybbadmin_staging
RABBITMQ_PASSWORD=R5t8K2b4W6y9M1n
RABBITMQ_URL=amqp://ybbadmin_staging:R5t8K2b4W6y9M1n@rabbitmq:5672/

# ===========================================
# JWT Authentication
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=J9n2M5v8C3x6Z1q4W7e2R5t8Y1u
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=R4b7N2m5V8c3X6z1Q9w2E5r8T1y
JWT_REFRESH_EXPIRATION=7d

# ===========================================
# MinIO / S3 Storage
# ===========================================
MINIO_ACCESS_KEY=M3k9L2p5M8n1
MINIO_SECRET_KEY=S6j2H5g8F1d4S7a2Q5w8E1r
MINIO_BUCKET=ybb-files-staging
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=s3.staging.ybbhub.com
MINIO_PUBLIC_SECURE=true

# ===========================================
# Service URLs (Public facing)
# ===========================================
# Replace with your actual domain
NEXT_PUBLIC_API_URL=https://api.staging.ybbhub.com/api/v1
NEXT_PUBLIC_APP_URL=https://admin.staging.ybbhub.com

# Internal Service URLs (Docker Network)
PAYMENT_SERVICE_URL=http://payment-service:8002
FILE_SERVICE_URL=http://file-service:8001
# Note: FILE_SERVICE_URL internal port is 8001 based on docker-compose.prod.yml

# ===========================================
# Email Service
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@staging.ybbhub.com

# ===========================================
# CORS Origins (comma-separated)
# ===========================================
CORS_ORIGINS=https://staging.ybbhub.com,https://admin.staging.ybbhub.com,https://api.staging.ybbhub.com,https://payment.staging.ybbhub.com,https://notification.staging.ybbhub.com,https://files.staging.ybbhub.com

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# File Upload Limits
# ===========================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ===========================================
# Application
# ===========================================
NODE_ENV=staging
GO_ENV=staging
PYTHON_ENV=staging
APP_NAME=YBB Platform (Staging)
APP_VERSION=1.0.0-staging

# Notification Service
RESEND_API_KEY=re_X4U94qTR_4ccJve4TpvvBDYPQPhQAWea5
RESEND_FROM=YBB Notifications <no-reply@notifications.ybbhub.com>

# ===========================================
# Admin Dashboard
# ===========================================
PGADMIN_EMAIL=admin@staging.ybbhub.com
PGADMIN_PASSWORD=A3d6F9g2H5j8
GRAFANA_USER=admin
GRAFANA_PASSWORD=G5h8J1k4L7z2

# ===========================================
# DYNAMIC DOKPLOY VARIABLES
# ===========================================
# These are used by docker-compose.dokploy.yml
APP_ENV=staging
DOMAIN_API=staging-api.ybbhub.com
DOMAIN_ADMIN=staging-admin.ybbhub.com
DOMAIN_PAYMENT=staging-payment.ybbhub.com
DOMAIN_FILES=staging-files.ybbhub.com
DOMAIN_NOTIFICATION=staging-notification.ybbhub.com
DOMAIN_DB=staging-db.ybbhub.com
DOMAIN_S3=staging-s3.ybbhub.com
DOMAIN_CONSOLE=staging-console.ybbhub.com
DOMAIN_QUEUE=staging-queue.ybbhub.com
DOMAIN_MONITOR=staging-monitor.ybbhub.com
DOMAIN_LANDING=staging.ybbhub.com

# ===========================================
# YBB Platform - Environment Configuration
# ===========================================
# This file serves as a template for .env files.
# For Local Development: Copy to .env
# For Staging (Dockploy): Copy to .env.staging / Paste in Dockploy Staging
# For Production (Dockploy): Copy to .env.prod / Paste in Dockploy Production

# ===========================================
# Application Environment
# ===========================================
NODE_ENV=development
GO_ENV=development
PYTHON_ENV=development
APP_NAME=YBB Platform
APP_VERSION=1.0.0

# ===========================================
# Database - PostgreSQL
# ===========================================
# Local Docker: postgres | Remote Staging: 31.97.111.96
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=ybb_user
DATABASE_PASSWORD=ybb_password
DATABASE_NAME=ybb_platform_db
# Connection Strings
DATABASE_URL=postgresql://ybb_user:ybb_password@postgres:5432/ybb_platform_db
DATABASE_URL_PAYMENT=postgresql://ybb_user:ybb_password@postgres:5432/ybb_payments_db
DATABASE_URL_FILE=postgresql://ybb_user:ybb_password@postgres:5432/ybb_files_db

# ===========================================
# Redis Cache
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@redis:6379

# ===========================================
# RabbitMQ Message Queue
# ===========================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Optional: Host/Port if not using URL
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRATION=7d

# ===========================================
# MinIO / S3 Storage
# ===========================================
# Access Keys
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ybb-files

# Internal Endpoint (Container-to-Container)
# Dev/Staging: minio:9000 | Prod (DO Spaces): nyc3.digitaloceanspaces.com
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# Public Endpoint (Browser Access / CDN)
# Dev: localhost:9000 | Staging: staging-s3.ybbhub.com | Prod: ybb-files.nyc3.cdn...
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false

# ===========================================
# Service URLs
# ===========================================
# Public Facing URLs (Browser -> API)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private Service-to-Service URLs (Internal Docker Network)
PAYMENT_SERVICE_URL=http://payment-service:8002
FILE_SERVICE_URL=http://file-service:8001
# ADMIN_DASHBOARD_URL=http://admin-dashboard:4001 (If needed)

# ===========================================
# Payment Gateway (Midtrans)
# ===========================================
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SB_SERVER_KEY=
MIDTRANS_SB_CLIENT_KEY=
MIDTRANS_IS_SANITIZED=false
MIDTRANS_IS_3DS=true

# ===========================================
# Email & Notification Service
# ===========================================
RESEND_API_KEY=
RESEND_FROM=YBB Notifications <no-reply@notifications.ybbhub.com>

# SMTP Removed (Using Resend consistently)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=


# ===========================================
# Admin & Monitoring Credentials
# ===========================================
PGADMIN_EMAIL=admin@ybbhub.com
PGADMIN_PASSWORD=admin
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ===========================================
# CORS & Limits
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf
LOG_LEVEL=debug
LOG_FORMAT=json

# ===========================================
# DOCKPLOY DYNAMIC CONFIGURATION
# ===========================================
# These control the conditional services in docker-compose.dokploy.yml
APP_ENV=prod
ENABLE_MINIO=false
ENABLE_FILESTASH=true

# Traefik Domain Labels
DOMAIN_LANDING=ybbhub.com
DOMAIN_API=api.ybbhub.com
DOMAIN_ADMIN=admin.ybbhub.com
DOMAIN_PAYMENT=payments.ybbhub.com
DOMAIN_FILES=files.ybbhub.com
DOMAIN_NOTIFICATION=notification.ybbhub.com
DOMAIN_DB=db.ybbhub.com
DOMAIN_S3=s3.ybbhub.com
DOMAIN_CONSOLE=console.ybbhub.com
DOMAIN_QUEUE=queue.ybbhub.com
DOMAIN_MONITOR=monitor.ybbhub.com


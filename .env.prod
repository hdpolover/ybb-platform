REDIS_PASSWORD=AtE4r-_k_dnJcWi215PZnoytA3nZ8bmx
REDIS_URL=redis://:AtE4r-_k_dnJcWi215PZnoytA3nZ8bmx@redis:6379

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=JyNnwC6x1wmI-bo5Oxn6sbfQhakxWUrr6cjPezI_R2HP-hlrc79mnumbZ1yATR9Y
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=2K-AjrBwzDEIxWmRUQq_JXkI_JYRL2f9p_8vnBkyhG-kJevoh9TJKffB2S33SUbM
JWT_REFRESH_EXPIRATION=7d

# ===========================================
# MinIO / S3 Storage
# ===========================================
MINIO_ACCESS_KEY=0f54278e5c41de5ee5fb
MINIO_SECRET_KEY=A8GcjcX7S7k9D2bTruQs1zTcW_ndnmBoAyGA1vzI
MINIO_BUCKET=ybb-files
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=s3.ybbhub.com
MINIO_PUBLIC_SECURE=true

# ===========================================
# Service URLs (Public facing)
# ===========================================
NEXT_PUBLIC_API_URL=https://api.ybbhub.com/api/v1
NEXT_PUBLIC_APP_URL=https://admin.ybbhub.com

# ===========================================
# Service URLs (Internal Docker Network)
# ===========================================
PAYMENT_SERVICE_URL=http://payment-service:8002
FILE_SERVICE_URL=http://file-service:8000

# ===========================================
# Payment - Stripe (Production keys)
# ===========================================
# REQUIRED: Get these from your Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ===========================================
# Email Service
# ===========================================
# REQUIRED: Configure your SMTP provider (Gmail, SendGrid, etc)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ybbhub.com

# ===========================================
# CORS Origins
# ===========================================
CORS_ORIGINS=https://ybbhub.com,https://admin.ybbhub.com,https://api.ybbhub.com,https://payment.ybbhub.com,https://notification.ybbhub.com,https://files.ybbhub.com

# ===========================================
# Rate Limiting & Uploads
# ===========================================
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ===========================================
# Application Metadata
# ===========================================
LOG_LEVEL=info
LOG_FORMAT=json
NODE_ENV=production
GO_ENV=production
PYTHON_ENV=production
APP_NAME=YBB Platform
APP_VERSION=1.0.0

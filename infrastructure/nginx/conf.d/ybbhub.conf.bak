
# ===============================================
# YBB Platform - Main Configuration (ybbhub.com)
# ===============================================

# ----------------------------------------------------------------------
# UPSTREAM DEFINITIONS
# ----------------------------------------------------------------------

# Core Services
upstream api_backend {
    server api:4000;
    keepalive 32;
}

upstream admin_backend {
    server admin-dashboard:4001;
    keepalive 16;
}

upstream payment_backend {
    server payment-service:8002;
    keepalive 16;
}

upstream notification_backend {
    server notification-service:4002;
    keepalive 16;
}

upstream file_backend {
    server file-service:8001;
    keepalive 16;
}

# Internal Tools
upstream minio_console {
    server minio:9001;
}

upstream minio_api {
    server minio:9000;
}

upstream rabbitmq_console {
    server rabbitmq:15672;
}

upstream grafana_backend {
    server grafana:3000;
}

upstream prometheus_backend {
    server prometheus:9090;
}

upstream pgadmin_backend {
    server pgadmin:80;
}

# ----------------------------------------------------------------------
# COMMON SECURITY HEADERS & SETTINGS
# ----------------------------------------------------------------------
# Can be included in each server block or defined globally if appropriate.
# Here we'll rely on server-specific blocks for clarity.

# ----------------------------------------------------------------------
# HTTP -> HTTPS REDIRECT (Generic for all subdomains)
# ----------------------------------------------------------------------
server {
    listen 80;
    server_name .ybbhub.com ybbhub.com;
    
    # Let's Encrypt challenge - Allow this on HTTP
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    
    # Redirect everything else to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ======================================================================
# PUBLIC SERVICES (HTTPS)
# ======================================================================
# Note: SSL certificates are assumed to be managed by Certbot/volumes.
# For local dev/initial setup, you might need self-signed certs or disable SSL.
# Assuming standard /etc/nginx/ssl paths as placeholders.

# MAIN DOMAIN -> Redirect to Admin
server {
    listen 443 ssl http2;
    server_name ybbhub.com;

    ssl_certificate /etc/nginx/ssl/live/ybbhub.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/ybbhub.com/privkey.pem;

    location / {
        return 301 https://admin.ybbhub.com$request_uri;
    }
}

# ADMIN DASHBOARD
server {
    listen 443 ssl http2;
    server_name admin.ybbhub.com;

    ssl_certificate /etc/nginx/ssl/live/ybbhub.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/ybbhub.com/privkey.pem;

    location / {
        proxy_pass http://admin_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Next.js static files caching
    location /_next/static {
        proxy_pass http://admin_backend;
        proxy_cache_valid 60m;
        add_header Cache-Control "public, immutable, max-age=31536000";
    }
}

# API GATEWAY
server {
    listen 443 ssl http2;
    server_name api.ybbhub.com;

    ssl_certificate /etc/nginx/ssl/live/ybbhub.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/ybbhub.com/privkey.pem;

    location / {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# PAYMENT SERVICE
server {
    listen 443 ssl http2;
    server_name payment.ybbhub.com;

    ssl_certificate /etc/nginx/ssl/live/ybbhub.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/ybbhub.com/privkey.pem;

    location / {
        proxy_pass http://payment_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# NOTIFICATION SERVICE
server {
    listen 443 ssl http2;
    server_name notification.ybbhub.com;

    ssl_certificate /etc/nginx/ssl/live/ybbhub.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/ybbhub.com/privkey.pem;

    location / {
        proxy_pass http://notification_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# FILE SERVICE
server {
    listen 443 ssl http2;
    server_name files.ybbhub.com;

    ssl_certificate /etc/nginx/ssl/live/ybbhub.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/ybbhub.com/privkey.pem;

    # Increase body size for uploads
    client_max_body_size 100M;

    location / {
        proxy_pass http://file_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ======================================================================
# INTERNAL TOOLS (HTTPS)
# ======================================================================

# MINIO CONSOLE
server {
    listen 443 ssl http2;
    server_name minio.ybbhub.com;

    ssl_certificate /etc/nginx/ssl/live/ybbhub.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/ybbhub.com/privkey.pem;

    # WebSocket support required for MinIO Console
    location / {
        proxy_pass http://minio_console;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# MINIO API (S3)
server {
    listen 443 ssl http2;
    server_name s3.ybbhub.com;

    ssl_certificate /etc/nginx/ssl/live/ybbhub.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/ybbhub.com/privkey.pem;

    client_max_body_size 100M;

    location / {
        proxy_pass http://minio_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}


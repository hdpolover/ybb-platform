# MinIO Configuration Template
# =============================
# Copy this file to minio.env and fill in the values.
# The minio.env file is gitignored for security.

# Root credentials (CHANGE IN PRODUCTION!)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Console address
MINIO_CONSOLE_ADDRESS=":9001"

# Browser access
MINIO_BROWSER=on

# Region
MINIO_REGION=us-east-1

# Compression (enable for text-based files)
MINIO_COMPRESSION_ENABLE=on
MINIO_COMPRESSION_EXTENSIONS=".txt,.log,.csv,.json,.xml,.html,.htm,.css,.js,.md"
MINIO_COMPRESSION_MIME_TYPES="text/*,application/json,application/xml"

# Healing settings
MINIO_HEAL_MAX_SLEEP=1s
MINIO_HEAL_MIN_SLEEP=100ms

# Scanner settings
MINIO_SCANNER_MAX_WAIT=5s
MINIO_SCANNER_IDLE_MODE=full

# API settings
MINIO_API_REQUESTS_MAX=10000
MINIO_API_REQUESTS_DEADLINE=10s
MINIO_API_CORS_ALLOW_ORIGIN="*"

# Update check (disable for air-gapped environments)
MINIO_UPDATE=off

# Prometheus metrics
MINIO_PROMETHEUS_AUTH_TYPE=public

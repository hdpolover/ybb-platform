<div style="text-align: center;">
    <h2 style="font-size: 24px; font-weight: 700; color: {{theme.primaryDark}}; margin: 0 0 24px;">
        {{#if isInvite}}Set your password{{else}}Set a new password{{/if}}
    </h2>

    <p style="font-size: 16px; color: #4b5563; margin-bottom: 32px; line-height: 1.6; text-align: left;">
        Hi {{name}},<br><br>
        {{#if isInvite}}
        You've been given access to the YBB admin dashboard{{#if roleName}} as <strong>{{roleName}}</strong>{{/if}}.
        Choose a password to activate your account:
        {{else}}
        A new password is required for your YBB admin dashboard account. Choose one with the button below:
        {{/if}}
    </p>

    <div style="margin: 32px 0;">
        <a href="{{setPasswordUrl}}" class="cta-button">
            Set your password
        </a>
    </div>

    <p style="font-size: 14px; color: {{theme.primaryDark}}; margin-bottom: 24px;">
        This link expires in 72 hours and can be used once.
    </p>

    <p style="font-size: 14px; color: #9ca3af; text-align: left;">
        If you didn't request this, you can ignore this email.
    </p>

    <div style="margin-top: 32px; border-top: 1px solid {{theme.border}}; padding-top: 24px; text-align: left;">
        <p style="font-size: 13px; color: #9ca3af; line-height: 1.5; margin-bottom: 8px;">
            Link not working? Use this URL:
        </p>
        <a href="{{setPasswordUrl}}" class="link break-word" style="font-size: 13px;">{{setPasswordUrl}}</a>
    </div>
</div>

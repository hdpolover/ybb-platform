<div style="text-align: center;">
    <div style="width: 64px; height: 64px; background-color: {{theme.primaryMuted}}; border-radius: 50%; margin: 0 auto 24px; display: flex; align-items: center; justify-content: center;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="{{theme.primary}}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
    </div>

    <h2 style="font-size: 24px; font-weight: 700; color: {{theme.primaryDark}}; margin: 0 0 8px;">
        Almost There — Continue Your Payment
    </h2>
    <p style="font-size: 16px; color: #6b7280; margin: 0 0 24px;">
        Hi {{name}}, you started a payment but it wasn&rsquo;t completed. Your spot is still open, so you can pick up right where you left off.
    </p>

    <div style="background-color: {{theme.primaryMuted}}; border: 1px solid {{theme.border}}; border-radius: 8px; padding: 24px; text-align: left; margin-bottom: 24px;">
        <table style="width: 100%; font-size: 14px; color: #374151;">
            <tr>
                <td style="padding-bottom: 8px; color: #6b7280;">Amount Due</td>
                <td style="padding-bottom: 8px; text-align: right; font-weight: 600;">{{currency}} {{amount}}</td>
            </tr>
            <tr>
                <td style="padding-bottom: 0px; color: #6b7280;">Invoice ID</td>
                <td style="padding-bottom: 0px; text-align: right; font-family: monospace; font-size: 12px;">{{orderId}}</td>
            </tr>
        </table>
    </div>

    <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 24px;">
        We&rsquo;ve reset this invoice so you can try again with a fresh checkout. It only takes a minute to finish.
    </p>

    <a href="{{paymentsPageUrl}}" class="cta-button">
        Continue Payment
    </a>
</div>

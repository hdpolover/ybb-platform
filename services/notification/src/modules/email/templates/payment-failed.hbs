<h2>Payment Failed</h2>

<p>Hi {{name}},</p>
<p>We were unable to process your payment for the following transaction:</p>

<div style="background-color: #fee2e2; padding: 16px; border-radius: 8px; margin: 16px 0; color: #991b1b;">
    <p style="margin: 4px 0;"><strong>Order ID:</strong> {{orderId}}</p>
    <p style="margin: 4px 0;"><strong>Amount:</strong> {{currency}} {{amount}}</p>
    <p style="margin: 4px 0;"><strong>Date:</strong> {{date}}</p>
    {{#if reason}}
    <p style="margin: 12px 0 4px; font-weight: 600;">Reason:</p>
    <p style="margin: 0;">{{reason}}</p>
    {{/if}}
</div>

<p>Please try again with a different payment method or contact your bank.</p>

<div style="text-align: center; margin-top: 30px;">
    {{#if retryUrl}}
    <a href="{{retryUrl}}" class="cta-button">Retry Payment</a>
    {{/if}}
</div>

<div style="text-align: center;">
    <h2 style="font-size: 24px; font-weight: 700; color: {{theme.primaryDark}}; margin: 0 0 16px;">
        Your Account Is Safe
    </h2>

    <p style="font-size: 16px; color: #4b5563; margin-bottom: 24px; line-height: 1.6;">
        Hi {{name}},
    </p>

    <p style="font-size: 16px; color: #4b5563; margin-bottom: 32px; line-height: 1.6; max-width: 480px; margin-left: auto; margin-right: auto;">

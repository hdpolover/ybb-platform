<div style="text-align: center;">
    <div style="width: 64px; height: 64px; background-color: #d1fae5; border-radius: 50%; margin: 0 auto 24px; display: flex; align-items: center; justify-content: center;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
    </div>

    <h2 style="font-size: 24px; font-weight: 700; color: #111827; margin: 0 0 8px;">
        Payment Successful
    </h2>
    <p style="font-size: 16px; color: #6b7280; margin: 0 0 32px;">
        Thank you for your payment
    </p>

    <div style="background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px; text-align: left; margin-bottom: 32px;">
        <div style="margin-bottom: 16px; border-bottom: 1px solid #e5e7eb; padding-bottom: 16px;">
            <p style="font-size: 32px; font-weight: 700; color: #111827; margin: 0;">
                {{currency}} {{amount}}
            </p>
            <p style="font-size: 14px; color: #6b7280; margin: 4px 0 0;">
                Total Amount Paid
            </p>
        </div>
        
        <table style="width: 100%; font-size: 14px; color: #374151;">
            {{#if items}}
            {{#each items}}
            <tr>
                <td style="padding-bottom: 8px; color: #6b7280;">{{name}} {{#if quantity}}(x{{quantity}}){{/if}}</td>
                <td style="padding-bottom: 8px; text-align: right; font-weight: 500;">{{price}}</td>
            </tr>
            {{/each}}
            <tr>
               <td colspan="2" style="border-bottom: 1px solid #e5e7eb; padding-bottom: 8px;"></td>
            </tr>
            {{else}}
            <tr>
                <td style="padding-bottom: 8px; color: #6b7280;">Description</td>
                <td style="padding-bottom: 8px; text-align: right; font-weight: 500;">{{description}}</td>
            </tr>
            {{/if}}
            <tr>
                <td style="padding-bottom: 8px; color: #6b7280;">Order ID</td>
                <td style="padding-bottom: 8px; text-align: right; font-family: monospace;">{{orderId}}</td>
            </tr>
            <tr>
                <td style="padding-bottom: 0px; color: #6b7280;">Date</td>
                <td style="padding-bottom: 0px; text-align: right;">{{date}}</td>
            </tr>
        </table>
    </div>

    <a href="{{invoiceUrl}}" class="cta-button" style="background-color: #fff; color: #374151 !important; border: 1px solid #d1d5db; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
        View Invoice / Receipt
    </a>
</div>
<div style="text-align: center;">
    <h2 style="font-size: 24px; font-weight: 700; color: {{theme.primaryDark}}; margin: 0 0 8px;">
        Payment Successful
    </h2>
    <p style="font-size: 16px; color: #6b7280; margin: 0 0 32px;">
        Thank you for your payment
    </p>

    {{#if program}}
    <p style="font-size: 13px; color: #6b7280; text-align: center; margin: 0 0 24px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">
        {{program}}
    </p>
    {{/if}}

    {{#if submissionPageUrl}}
    <div style="margin: 0 0 24px; padding: 16px; border-radius: 8px; background-color: #eff6ff; border: 1px solid #bfdbfe; text-align: left;">
        <p style="margin: 0; font-size: 14px; color: #1e3a8a; line-height: 1.6;">
            Your payment is confirmed. You can now continue to the submission page and finalize your application.
        </p>
    </div>
    {{/if}}

    <div style="background-color: {{theme.primaryMuted}}; border: 1px solid {{theme.border}}; border-radius: 8px; padding: 24px; text-align: left; margin-bottom: 32px;">
        <div style="margin-bottom: 16px; border-bottom: 1px solid #e5e7eb; padding-bottom: 16px;">
            <p style="font-size: 32px; font-weight: 700; color: {{theme.primaryDark}}; margin: 0;">
                {{currency}} {{amount}}
            </p>
            <p style="font-size: 14px; color: #6b7280; margin: 4px 0 0;">
                Total Amount Paid
            </p>
        </div>
        
        <table style="width: 100%; font-size: 14px; color: #374151;">
            {{#if items}}
            {{#each items}}
            <tr>
                <td style="padding-bottom: 8px; color: #6b7280;">{{name}} {{#if quantity}}(x{{quantity}}){{/if}}</td>
                <td style="padding-bottom: 8px; text-align: right; font-weight: 500;">{{price}}</td>
            </tr>
            {{/each}}
            <tr>
               <td colspan="2" style="border-bottom: 1px solid #e5e7eb; padding-bottom: 8px;"></td>
            </tr>
            {{else}}
            <tr>
                <td style="padding-bottom: 8px; color: #6b7280;">Description</td>
                <td style="padding-bottom: 8px; text-align: right; font-weight: 500;">{{description}}</td>
            </tr>
            {{/if}}
            <tr>
                <td style="padding-bottom: 8px; color: #6b7280;">Order ID</td>
                <td style="padding-bottom: 8px; text-align: right; font-family: monospace;">{{orderId}}</td>
            </tr>
            <tr>
                <td style="padding-bottom: 0px; color: #6b7280;">Date</td>
                <td style="padding-bottom: 0px; text-align: right;">{{date}}</td>
            </tr>
        </table>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px;">
        {{#if submissionPageUrl}}
        <a href="{{submissionPageUrl}}" class="cta-button">
            Continue to Submission
        </a>
        {{/if}}
        <a href="{{invoiceUrl}}" class="cta-button" style="background-color: #fff; color: {{theme.primaryDark}} !important; border: 1px solid {{theme.border}}; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
            View Payment Details
        </a>
    </div>
</div>

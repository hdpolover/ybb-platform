<div style="text-align: center;">
    <h2 style="font-size: 24px; font-weight: 700; color: {{theme.primaryDark}}; margin: 0 0 24px;">
        Refund Initiated
    </h2>

    {{#if program}}
    <p style="font-size: 13px; color: #6b7280; text-align: center; margin: 0 0 24px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">
        {{program}}
    </p>
    {{/if}}

    <p style="font-size: 16px; color: #4b5563; margin-bottom: 24px;">
        Hi {{name}},
    </p>

    <p style="font-size: 16px; color: #4b5563; margin-bottom: 32px; line-height: 1.6;">
        A refund of <strong>{{currency}} {{amount}}</strong> has been initiated for your recent payment.
    </p>

        <div style="background-color: {{theme.primaryMuted}}; border: 1px solid {{theme.border}}; border-radius: 8px; padding: 20px; text-align: left; margin-bottom: 24px; max-width: 400px; margin-left: auto; margin-right: auto;">
         <p style="font-size: 14px; color: #6b7280; margin: 0 0 4px;">Original Order ID</p>
            <p style="font-size: 16px; font-weight: 500; color: {{theme.primaryDark}}; margin: 0; font-family: monospace;">{{orderId}}</p>
    </div>

    <p style="font-size: 14px; color: #6b7280;">
        Refunds typically take 5-10 business days to appear on your statement, depending on your bank.
    </p>
</div>
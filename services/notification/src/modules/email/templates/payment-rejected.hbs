<div style="text-align: center;">
    <h2 style="font-size: 24px; font-weight: 700; color: #111827; margin: 0 0 8px;">
        Payment Not Verified
    </h2>
    <p style="font-size: 16px; color: #6b7280; margin: 0 0 24px;">
        Hi {{name}}, our team reviewed your payment and could not verify it.
    </p>

    {{#if program}}
    <p style="font-size: 13px; color: #6b7280; text-align: center; margin: 0 0 24px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">
        {{program}}
    </p>
    {{/if}}

    <div style="background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 16px; text-align: left; margin-bottom: 24px;">
        <p style="font-size: 13px; font-weight: 600; color: #92400e; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 0.04em;">
            Reason from our reviewer
        </p>
        <p style="font-size: 14px; color: #78350f; margin: 0; line-height: 1.5;">
            {{reason}}
        </p>
    </div>

    <div style="background-color: {{theme.primaryMuted}}; border: 1px solid {{theme.border}}; border-radius: 8px; padding: 24px; text-align: left; margin-bottom: 24px;">
        <table style="width: 100%; font-size: 14px; color: #374151;">
            <tr>
                <td style="padding-bottom: 8px; color: #6b7280;">Amount Submitted</td>
                <td style="padding-bottom: 8px; text-align: right; font-weight: 600;">{{currency}} {{amount}}</td>
            </tr>
            <tr>
                <td style="padding-bottom: 0px; color: #6b7280;">Invoice ID</td>
                <td style="padding-bottom: 0px; text-align: right; font-family: monospace; font-size: 12px;">{{orderId}}</td>
            </tr>
        </table>
    </div>

    <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 24px;">
        Please review the reason above, then submit a new payment with the
        corrected details. Your application is still open and waiting on this step.
    </p>

    <a href="{{paymentsPageUrl}}" class="cta-button">
        Submit a New Payment
    </a>
</div>

{{! services/notification/src/modules/email/templates/ambassador-welcome.hbs }}
<div style="text-align: center;">
    <h2 style="font-size: 24px; font-weight: 700; color: {{theme.primaryDark}}; margin: 0 0 16px;">
        You're now a {{#if brand.name}}{{brand.name}}{{else}}YBB{{/if}} Ambassador!
    </h2>

    <p style="font-size: 16px; color: #4b5563; margin-bottom: 24px; line-height: 1.6;">
        Hi {{name}},
    </p>

    <p style="font-size: 16px; color: #4b5563; margin-bottom: 32px; line-height: 1.6; max-width: 500px; margin-left: auto; margin-right: auto;">
        Congratulations. You have been officially activated as an ambassador for
        <strong>{{#if brand.name}}{{brand.name}}{{else}}the program{{/if}}</strong>.
        Everything you need to get started is below.
    </p>

    <div style="background-color: {{theme.primaryMuted}}; border-radius: 8px; padding: 24px; text-align: left; margin-bottom: 32px; border: 1px solid {{theme.border}};">
        <p style="margin: 0 0 12px; font-weight: 600; color: #374151; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em;">Your Referral Code</p>

        <div style="background-color: #ffffff; border: 1.5px solid {{theme.border}}; border-radius: 6px; padding: 20px; text-align: center; margin-bottom: 16px;">
            <code style="font-family: 'Courier New', Courier, monospace; font-size: 30px; font-weight: 700; color: {{theme.primaryDark}}; letter-spacing: 0.12em;">{{referralCode}}</code>
        </div>

        <p style="margin: 0 0 10px; font-size: 14px; color: #4b5563; line-height: 1.6;">
            This code does two things:
        </p>
        <ul style="margin: 0; padding-left: 20px; color: #4b5563; font-size: 14px; line-height: 1.8;">
            <li><strong>Sign in:</strong> use it with your email address to log in to your ambassador portal.</li>
            <li><strong>Refer others:</strong> share it so registrants can enter your code during sign-up.</li>
        </ul>
    </div>

    <a href="{{loginUrl}}" class="cta-button">
        Sign In to Your Ambassador Portal
    </a>

    <p style="margin-top: 32px; font-size: 14px; color: #6b7280; line-height: 1.5;">
        Start sharing your referral code and watch your impact grow. We are glad to have you on board.
    </p>
</div>

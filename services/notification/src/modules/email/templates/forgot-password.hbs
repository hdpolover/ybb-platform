<div style="text-align: center;">
    <h2 style="font-size: 24px; font-weight: 700; color: #111827; margin: 0 0 24px;">
        Reset Your Password
    </h2>
    
    <p style="font-size: 16px; color: #4b5563; margin-bottom: 32px; line-height: 1.6; text-align: left;">
        Hi {{name}},<br><br>
        We received a request to reset your password{{#if brand.name}} for <strong>{{brand.name}}</strong>{{/if}}.
        Click the link below to choose a new password:
    </p>

    <div style="margin: 32px 0;">
        <a href="{{resetUrl}}" class="cta-button">
            Reset Password
        </a>
    </div>

    <p style="font-size: 14px; color: #6b7280; margin-bottom: 24px;">
        This link will expire in 60 minutes.
    </p>

    <p style="font-size: 14px; color: #9ca3af; text-align: left;">
        If you didn't request this change, you can ignore this email.
    </p>

     <div style="margin-top: 32px; border-top: 1px solid #e5e7eb; padding-top: 24px; text-align: left;">
        <p style="font-size: 13px; color: #9ca3af; line-height: 1.5; margin-bottom: 8px;">
            Link not working? Use this URL:
        </p>
        <a href="{{resetUrl}}" class="link break-word" style="font-size: 13px;">{{resetUrl}}</a>
    </div>
</div>
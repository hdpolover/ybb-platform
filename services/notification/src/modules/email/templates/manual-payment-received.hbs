<div style="text-align: center;">
    <h2 style="font-size: 24px; font-weight: 700; color: {{theme.primaryDark}}; margin: 0 0 16px;">
        Payment Proof Received
    </h2>

    {{#if program}}
    <p style="font-size: 13px; color: #6b7280; text-align: center; margin: 0 0 24px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">
        {{program}}
    </p>
    {{/if}}

    <p style="font-size: 16px; color: #4b5563; margin-bottom: 24px;">
        Hi {{name}},
    </p>

    <p style="font-size: 16px; color: #4b5563; margin-bottom: 32px; line-height: 1.6;">
        We have received your manual payment proof for <strong>{{currency}} {{amount}}</strong>. Our team will review it shortly.
    </p>

    <div style="background-color: {{theme.primaryMuted}}; border: 1px solid {{theme.border}}; border-radius: 6px; padding: 16px; text-align: center; margin-bottom: 24px;">
        <p style="font-size: 14px; color: {{theme.primaryDark}}; margin: 0;">
            <strong>Status:</strong> Pending Review
        </p>
    </div>

    <p style="font-size: 14px; color: #6b7280;">
        You will receive another email once your payment is confirmed.
    </p>
</div>
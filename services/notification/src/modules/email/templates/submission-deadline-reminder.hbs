<div style="text-align: center;">
    <h2 style="font-size: 24px; font-weight: 700; color: {{theme.primaryDark}}; margin: 0 0 8px;">
        {{#if isLastDay}}
        Last Day to Submit Your Application
        {{else}}
        {{daysRemaining}} Days Left to Submit Your Application
        {{/if}}
    </h2>
    <p style="font-size: 16px; color: #6b7280; margin: 0 0 24px;">
        Hi {{name}}, your application is still in draft. Complete and submit it before the deadline so it can be reviewed.
    </p>

    {{#if program}}
    <p style="font-size: 13px; color: #6b7280; text-align: center; margin: 0 0 24px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">
        {{program}}
    </p>
    {{/if}}

    <div style="background-color: {{theme.primaryMuted}}; border: 1px solid {{theme.border}}; border-radius: 8px; padding: 24px; text-align: left; margin-bottom: 24px;">
        <table style="width: 100%; font-size: 14px; color: #374151;">
            <tr>
                <td style="padding-bottom: 8px; color: #6b7280;">Time Remaining</td>
                <td style="padding-bottom: 8px; text-align: right; font-weight: 600;">
                    {{daysRemainingLabel}}
                </td>
            </tr>
            {{#if deadlineFormatted}}
            <tr>
                <td style="padding-bottom: 0px; color: #6b7280;">Submission Deadline</td>
                <td style="padding-bottom: 0px; text-align: right; font-weight: 600;">{{deadlineFormatted}}</td>
            </tr>
            {{/if}}
        </table>
    </div>

    <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 24px;">
        Applications reviewed after the deadline may not be considered. Pick up where you left off and finish it now.
    </p>

    <a href="{{submissionPageUrl}}" class="cta-button">
        Continue Your Application
    </a>
</div>

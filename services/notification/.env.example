# Notification Service Environment
NODE_ENV=development
PORT=4002

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis (notification idempotency)
# Use REDIS_URL or REDIS_HOST/REDIS_PORT style config.
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
NOTIFICATION_QUEUE_MAX_RETRIES=3
NOTIFICATION_QUEUE_RETRY_DELAY_MS=15000
NOTIFICATION_IDEMPOTENCY_ENABLED=true
NOTIFICATION_IDEMPOTENCY_DEFAULT_TTL_SECONDS=86400
NOTIFICATION_IDEMPOTENCY_PAYMENT_TTL_SECONDS=604800

# Resend (Email Provider)
RESEND_API_KEY=change_me
RESEND_FROM=YBB Notifications <no-reply@notifications.ybbhub.com>

# Observability
LOKI_URL=http://host.docker.internal:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_LOG_LEVEL=info

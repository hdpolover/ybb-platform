# Development Dockerfile
FROM golang:1.25-alpine

WORKDIR /app

# Install git then air
RUN apk add --no-cache git && \
    go install github.com/air-verse/air@latest

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Expose port
EXPOSE 8080

# Run directly with go run (hot reload disabled for compatibility)
CMD ["go", "run", "cmd/server/main.go"]

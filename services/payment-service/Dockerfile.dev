# Development Dockerfile
FROM golang:1.21-alpine

WORKDIR /app

# Install air for hot reload and git
RUN go install github.com/cosmtrek/air@latest && \
    apk add --no-cache git

# Copy go mod files
COPY go.mod go.sum* ./
RUN go mod download || true

# Copy source code
COPY . .

# Expose port
EXPOSE 8080

# Run with air for hot reload
CMD ["air", "-c", ".air.toml"]

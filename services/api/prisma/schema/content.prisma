// ============================================================================
// PROGRAM CONTENT
// ============================================================================

model ProgramFaq {
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId String      @map("program_id") @db.Uuid
  question  String      @db.Text
  answer    String      @db.Text
  category  FaqCategory @default(general)
  order     Int         @default(0) // For sorting
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(6)

  // Relations
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([category])
  @@index([order])
  @@map("program_faqs")
}

model ProgramTimeline {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId   String       @map("program_id") @db.Uuid
  date        DateTime     @db.Timestamptz(6)
  endDate     DateTime?    @map("end_date") @db.Timestamptz(6)
  title       String       @db.VarChar(255)
  description String?      @db.Text
  icon        String?      @db.VarChar(100)
  type        TimelineType @default(custom)

  // Dynamic Configuration
  completionType   TimelineCompletionType @default(date_passed) @map("completion_type")
  completionConfig Json                   @default("{}") @map("completion_config") @db.Json
  // Config Examples:
  // status_change: { "status": "accepted" }
  // payment_completed: { "feeType": "registration_fee" }
  // document_uploaded: { "requirementId": "uuid..." }

  targetAudience PricingTarget @default(all) @map("target_audience")
  order          Int           @default(0)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  // Relations
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([date])
  @@index([order])
  @@map("program_timeline")
}

model ProgramSchedule {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId   String    @map("program_id") @db.Uuid
  day         String    @db.VarChar(100) // e.g., "Day 1", "Monday", "March 15"
  startTime   String?   @map("start_time") @db.VarChar(20) // e.g., "09:00"
  endTime     String?   @map("end_time") @db.VarChar(20) // e.g., "17:00"
  activity    String    @db.VarChar(255)
  description String?   @db.Text
  location    String?   @db.VarChar(255)
  speaker     String?   @db.VarChar(255) // Speaker name if applicable
  order       Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([order])
  @@map("program_schedules")
}

model ProgramSpeaker {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId    String    @map("program_id") @db.Uuid
  name         String    @db.VarChar(255)
  title        String?   @db.VarChar(255) // Job title or role
  organization String?   @db.VarChar(255)
  bio          String?   @db.Text
  photoUrl     String?   @map("photo_url") @db.VarChar(500)
  email        String?   @db.VarChar(255)
  linkedinUrl  String?   @map("linkedin_url") @db.VarChar(500)
  twitterUrl   String?   @map("twitter_url") @db.VarChar(500)
  order        Int       @default(0)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([order])
  @@map("program_speakers")
}

model ProgramGallery {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId   String    @map("program_id") @db.Uuid
  imageUrl    String    @map("image_url") @db.VarChar(500)
  videoUrl    String?   @map("video_url") @db.VarChar(500) // For YouTube/Vimeo links
  title       String?   @db.VarChar(255)
  description String?   @db.Text
  year        Int? // Optional: year the photo was taken — shown on the admin gallery card
  type        String    @default("image") @db.VarChar(50) // image, video
  order       Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([type])
  @@index([order])
  @@map("program_gallery")
}

model ProgramTestimonial {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId    String?   @map("program_id") @db.Uuid
  brandId      String?   @map("brand_id") @db.Uuid
  name         String    @db.VarChar(255)
  role         String?   @db.VarChar(255) // e.g., "Participant 2024", "Alumni"
  company      String?   @db.VarChar(255)
  testimonial  String    @db.Text
  category     String    @default("alumni") @db.VarChar(50) // alumni, speaker, mentor, partner
  type         String    @default("text") @db.VarChar(20) // text, video
  videoUrl     String?   @map("video_url") @db.VarChar(500) // For video testimonials
  thumbnailUrl String?   @map("thumbnail_url") @db.VarChar(500) // Video thumbnail
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  rating       Int?      @db.SmallInt // Optional 1-5 rating
  isFeatured   Boolean   @default(false) @map("is_featured") // Highlight on homepage
  isActive     Boolean   @default(true) @map("is_active")
  order        Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  program Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
  brand   Brand?   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([brandId])
  @@index([type])
  @@index([isFeatured])
  @@index([order])
  @@map("program_testimonials")
}


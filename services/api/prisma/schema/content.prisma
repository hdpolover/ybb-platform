model ProgramResource {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId   String    @map("program_id") @db.Uuid
  title       String    @db.VarChar(255)
  description String?   @db.Text
  fileUrl     String    @map("file_url") @db.VarChar(500)
  fileSize    BigInt?   @map("file_size") // In bytes
  fileType    String?   @map("file_type") @db.VarChar(50) // pdf, docx, pptx
  type        String    @db.VarChar(50) // brochure, guide, presentation, handbook, media_kit
  isPublic    Boolean   @default(true) @map("is_public") // Visible before login
  downloads   Int       @default(0) // Track download count
  order       Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([type])
  @@index([isPublic])
  @@index([order])
  @@map("program_resources")
}

model ProgramAnnouncement {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId      String    @map("program_id") @db.Uuid
  title          String    @db.VarChar(255)
  content        String    @db.Text
  imageUrl       String?   @map("image_url") @db.VarChar(500)
  category       String?   @db.VarChar(50) // e.g., "News", "Award", "Scholarship", "General"
  tags           String[]  @default([])
  targetAudience String    @default("all") @map("target_audience") @db.VarChar(50) // all, applicants, accepted, rejected, participants
  sendEmail      Boolean   @default(false) @map("send_email")
  isPinned       Boolean   @default(false) @map("is_pinned")
  publishDate    DateTime  @default(now()) @map("publish_date") @db.Timestamptz(6)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  program Program                   @relation(fields: [programId], references: [id], onDelete: Cascade)
  reads   ProgramAnnouncementRead[]

  @@index([programId])
  @@index([category])
  @@index([targetAudience])
  @@index([isPinned])
  @@index([publishDate])
  @@map("program_announcements")
}

model ProgramAnnouncementRead {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  programAnnouncement ProgramAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
  @@map("program_announcement_reads")
}

model CertificateTemplate {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId   String    @map("program_id") @db.Uuid
  name        String    @db.VarChar(255)
  templateUrl String    @map("template_url") @db.VarChar(500) // Background image/PDF
  fields      Json      @default("[]") @db.Json // [{name: "participant_name", x: 100, y: 200, fontSize: 24}]
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("certificate_templates")
}

model ProgramAward {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId String @map("program_id") @db.Uuid

  // Award Details
  name        String  @db.VarChar(255)
  description String? @db.Text
  category    String? @db.VarChar(100) // e.g., "Best Presentation", "1st Place", "Most Innovative"
  tier        String? @db.VarChar(50) // gold, silver, bronze, honorable_mention

  // UI Display Fields
  tags        String[] @default([])
  winnerCount Int?     @map("winner_count")
  color       String?  @db.VarChar(7)

  // Visual
  badgeUrl String? @map("badge_url") @db.VarChar(500)
  iconUrl  String? @map("icon_url") @db.VarChar(500)

  // Certificate Link
  certificateTemplateId String? @map("certificate_template_id") @db.Uuid

  // Status
  isActive  Boolean   @default(true) @map("is_active")
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  legacyId  Int?      @unique @map("legacy_id")

  // Relations
  program    Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  recipients ParticipantAward[]

  @@index([programId])
  @@index([category])
  @@index([isActive])
  @@map("program_awards")
}

model DocumentTemplate {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId String @map("program_id") @db.Uuid

  // Template Info
  name        String               @db.VarChar(255)
  type        DocumentTemplateType @default(custom)
  description String?              @db.Text

  // Template Content
  templateUrl String? @map("template_url") @db.VarChar(500) // Background image/PDF
  htmlContent String? @map("html_content") @db.Text // HTML template

  // Placeholders/Fields Configuration
  placeholders Json @default("[]") @db.Json

  // Layout Configuration
  layoutConfig Json @default("{}") @map("layout_config") @db.Json

  // Status
  isActive  Boolean   @default(true) @map("is_active")

  // Visibility / Audience Rules
  audienceType   String @default("all_registered") @map("audience_type") @db.VarChar(50)
  audienceConfig Json   @default("{}") @map("audience_config") @db.Json

  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  legacyId  Int?      @unique @map("legacy_id")

  // Relations
  generatedDocuments ParticipantDocument[]

  @@index([programId])
  @@index([type])
  @@index([isActive])
  @@map("document_templates")
}


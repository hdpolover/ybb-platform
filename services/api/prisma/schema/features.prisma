// ============================================================================
// SYSTEM FEATURES (Announcements, Support, Notifications)
// ============================================================================

model SystemAnnouncement {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // Announcement Details
  title   String  @db.VarChar(255)
  content String  @db.Text
  summary String? @db.Text

  // Targeting
  targetAudience    AnnouncementTarget @default(all) @map("target_audience")
  programCategoryId String?            @map("program_category_id") @db.Uuid
  programId         String?            @map("program_id") @db.Uuid

  // Priority & Type
  priority AnnouncementPriority @default(normal)
  type     AnnouncementType     @default(general)

  // Visibility
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  // Display Settings
  isDismissible Boolean @default(true) @map("is_dismissible")
  showBanner    Boolean @default(false) @map("show_banner")

  // Action
  actionUrl   String? @map("action_url") @db.VarChar(500)
  actionLabel String? @map("action_label") @db.VarChar(100)

  // Scheduling
  startDate DateTime? @map("start_date") @db.Timestamptz(6)
  endDate   DateTime? @map("end_date") @db.Timestamptz(6)

  // Author
  createdBy String  @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  // Metadata
  metadata Json @default("{}") @db.Json

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  programCategory ProgramCategory?       @relation(fields: [programCategoryId], references: [id])
  program         Program?               @relation(fields: [programId], references: [id], onDelete: Cascade)
  creator         Admin                  @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  updater         Admin?                 @relation("AnnouncementUpdater", fields: [updatedBy], references: [id])
  reads           UserAnnouncementRead[]

  @@index([isPublished, publishedAt, deletedAt])
  @@index([startDate, endDate, isPublished, deletedAt])
  @@index([targetAudience, programCategoryId])
  @@index([showBanner, isPublished, deletedAt])
  @@map("system_announcements")
}

model UserAnnouncementRead {
  id             String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  announcementId String @map("announcement_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)
  
  // Added fields to match code
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(6)
  isDismissed    Boolean   @default(false) @map("is_dismissed")
  dismissedAt    DateTime? @map("dismissed_at") @db.Timestamptz(6)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   SystemAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
  @@map("user_announcement_reads")
}

model UserNotification {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Notification Details
  type    String @db.VarChar(50)
  title   String @db.VarChar(255)
  message String @db.Text

  // Action
  actionUrl   String? @map("action_url") @db.VarChar(500)
  actionLabel String? @map("action_label") @db.VarChar(100)

  // Metadata
  relatedEntityType String? @map("related_entity_type") @db.VarChar(50)
  relatedEntityId   String? @map("related_entity_id") @db.Uuid
  metadata          Json    @default("{}") @db.Json

  // Status
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at") @db.Timestamptz(6)

  // Priority
  priority NotificationPriority @default(normal)

  // Delivery
  sentViaEmail Boolean   @default(false) @map("sent_via_email")
  sentViaSms   Boolean   @default(false) @map("sent_via_sms")
  emailSentAt  DateTime? @map("email_sent_at") @db.Timestamptz(6)
  smsSentAt    DateTime? @map("sms_sent_at") @db.Timestamptz(6)

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead, deletedAt])
  @@index([userId, createdAt])
  @@index([userId, priority])
  @@index([type])
  @@map("user_notifications")
}

model SupportTicket {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  assignedTo    String?  @map("assigned_to") @db.Uuid
  programId     String?  @map("program_id") @db.Uuid

  // Ticket Details
  ticketNumber String  @unique @map("ticket_number") @db.VarChar(20) // e.g., TKT-2024-001234
  category     String  @db.VarChar(100)
  subCategory  String? @map("sub_category") @db.VarChar(100)
  subject      String  @db.VarChar(255)
  description  String  @db.Text

  // Status & Priority
  status   SupportTicketStatus   @default(open)
  priority SupportTicketPriority @default(normal)

  // Resolution
  resolution   String?   @db.Text
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy   String?   @map("resolved_by") @db.Uuid
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy     String?   @map("closed_by") @db.Uuid
  closedReason String?   @map("closed_reason") @db.Text

  // Feedback
  satisfactionRating Int?    @map("satisfaction_rating") @db.SmallInt // 1-5
  feedback           String? @db.Text
  
  // Audit
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  legacyId  Int?      @unique @map("legacy_id")

  // Relations
  messages SupportTicketMessage[]

  @@index([participantId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
  @@index([ticketNumber])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid

  // Message Details
  message     String  @db.Text
  isFromAdmin Boolean @default(false) @map("is_from_admin")
  senderId    String  @map("sender_id") @db.Uuid // User ID (participant or admin)
  senderName  String  @map("sender_name") @db.VarChar(255)

  // Attachments
  attachments Json @default("[]") @db.Json // [{filename, url, size, type}]

  // Status
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at") @db.Timestamptz(6)

  // Internal Note (only visible to admins)
  isInternalNote Boolean @default(false) @map("is_internal_note")

  // Audit
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  legacyId  Int?      @unique @map("legacy_id")

  // Relations
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@map("support_ticket_messages")
}

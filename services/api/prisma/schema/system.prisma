// ============================================================================
// SYSTEM & FILES
// ============================================================================

model File {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  filename    String   @db.VarChar(255)
  contentType String   @map("content_type") @db.VarChar(100)
  size        BigInt
  url         String   @db.Text
  storagePath String   @map("storage_path") @db.Text
  userId      String   @map("user_id") @db.Uuid
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("files")
}

model MigrationTracking {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tableName      String   @map("table_name") @db.VarChar(100)
  mysqlId        Int      @map("mysql_id")
  postgresId     String   @map("postgres_id") @db.Uuid
  migratedAt     DateTime @default(now()) @map("migrated_at") @db.Timestamptz(6)
  migrationBatch String?  @map("migration_batch") @db.VarChar(50)

  @@unique([tableName, mysqlId])
  @@index([tableName])
  @@index([mysqlId])
  @@index([postgresId])
  @@map("migration_tracking")
}

model AuditLog {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  event          String   @db.VarChar(255) // e.g., "user.verify-email", "payment.succeeded"
  payload        Json?    @db.JsonB        // Full event payload
  entityType     String?  @map("entity_type") @db.VarChar(50)
  entityId       String?  @map("entity_id") @db.VarChar(255)
  actorId        String?  @map("actor_id") @db.Uuid // If initiated by a user
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.Text
  status         String?  @db.VarChar(50) // SUCCESS, FAILURE
  errorMessage   String?  @map("error_message") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([event])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

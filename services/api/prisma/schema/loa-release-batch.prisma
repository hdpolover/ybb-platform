// ============================================================================
// LOA RELEASE BATCHES
// ============================================================================

model LoaReleaseBatch {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programId      String    @map("program_id") @db.Uuid
  name           String    @db.VarChar(255)
  submissionFrom DateTime  @map("submission_from") @db.Timestamptz(6)
  submissionTo   DateTime  @map("submission_to") @db.Timestamptz(6)
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(6)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  program              Program               @relation(fields: [programId], references: [id])
  participantDocuments ParticipantDocument[]

  @@index([programId])
  @@index([programId, submissionFrom, submissionTo])
  @@map("loa_release_batches")
}

}

model UserBlockedAccount {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Block Details
  blockReason      String    @map("block_reason") @db.VarChar(50)
  blockDescription String    @map("block_description") @db.Text
  blockType        BlockType @default(temporary) @map("block_type")

  // Duration
  blockedAt    DateTime  @default(now()) @map("blocked_at") @db.Timestamptz(6)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(6)
  unblockedAt  DateTime? @map("unblocked_at") @db.Timestamptz(6)

  // Authority
  blockedBy   String? @map("blocked_by") @db.Uuid
  unblockedBy String? @map("unblocked_by") @db.Uuid

  // Additional Info
  violationsCount Int     @default(1) @map("violations_count")
  notes           String? @db.Text

  // Status
  isActive Boolean @default(true) @map("is_active")

  // Relations
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocker   Admin? @relation("BlockedBy", fields: [blockedBy], references: [id])
  unblocker Admin? @relation("UnblockedBy", fields: [unblockedBy], references: [id])

  @@index([userId])
  @@index([userId, isActive])
  @@index([blockedUntil])
  @@map("user_blocked_accounts")
}

model UserActivityLog {
  id     String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String? @map("user_id") @db.Uuid

  // Activity Details
  activityType     String  @map("activity_type") @db.VarChar(100)

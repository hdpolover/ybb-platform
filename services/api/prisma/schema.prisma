  normal
  high
  urgent
}

enum AnnouncementTarget {
  all
  participants
  ambassadors
  specific_program
}

enum AnnouncementPriority {
  low
  normal
  high
  urgent
}

enum AnnouncementType {
  general
  maintenance
  deadline
  feature
  alert
}

enum FaqCategory {

  submittedAt          DateTime? @map("submitted_at") @db.Timestamptz(6)
  lastEditedAt         DateTime? @map("last_edited_at") @db.Timestamptz(6)
  underReviewAt        DateTime? @map("under_review_at") @db.Timestamptz(6)
  interviewScheduledAt DateTime? @map("interview_scheduled_at") @db.Timestamptz(6)
  acceptedAt           DateTime? @map("accepted_at") @db.Timestamptz(6)
  rejectedAt           DateTime? @map("rejected_at") @db.Timestamptz(6)
  waitlistedAt         DateTime? @map("waitlisted_at") @db.Timestamptz(6)
  withdrawnAt          DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnBy          String?   @map("withdrawn_by") @db.Uuid

  // Payment Timeline
  paymentRequestedAt DateTime? @map("payment_requested_at") @db.Timestamptz(6)
  paymentCompletedAt DateTime? @map("payment_completed_at") @db.Timestamptz(6)

  // Document Upload Tracking
  allDocumentsUploadedAt DateTime? @map("all_documents_uploaded_at") @db.Timestamptz(6)

  // Status History
  statusHistory Json @default("[]") @map("status_history") @db.Json

  // Audit
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?   @map("deleted_by") @db.Uuid

// ============================================================================
// CORE AUTHENTICATION (Brand-Scoped)
// ============================================================================

// Authentication Providers - Configurable OAuth/Auth Providers
model AuthProvider {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @unique @db.VarChar(50) // 'local', 'google', 'facebook', 'apple', etc.
  displayName String   @map("display_name") @db.VarChar(100) // 'Email & Password', 'Google', 'Facebook'
  description String?  @db.Text
  
  // OAuth Configuration (optional, for OAuth providers)
  clientId     String? @map("client_id") @db.VarChar(255)
  clientSecret String? @map("client_secret") @db.VarChar(255)
  authUrl      String? @map("auth_url") @db.VarChar(500)
  tokenUrl     String? @map("token_url") @db.VarChar(500)
  scopes       Json?   @default("[]") @db.Json // ["email", "profile"]
  
  // Status
  isActive     Boolean @default(true) @map("is_active")
  isOAuth      Boolean @default(false) @map("is_oauth") // true for OAuth providers, false for local
  
  // UI
  icon         String? @db.VarChar(100) // Icon identifier or URL
  buttonColor  String? @map("button_color") @db.VarChar(7) // Hex color for button
  order        Int     @default(0) // Display order
  
  // Audit
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  // Relations
  identities   UserIdentity[]
  
  @@index([name])
  @@index([isActive])
  @@index([order])
  @@map("auth_providers")
}

model User {
  id                String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email             String @db.VarChar(255)
  programCategoryId String @map("program_category_id") @db.Uuid

  // Authentication - passwordHash kept for backward compatibility
  passwordHash             String?   @map("password_hash") @db.VarChar(255)
  emailVerified            Boolean   @default(false) @map("email_verified")
  emailVerificationToken   String?   @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpires DateTime? @map("email_verification_expires") @db.Timestamptz(6)
  passwordResetToken       String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires     DateTime? @map("password_reset_expires") @db.Timestamptz(6)

  // Account Status
  isActive Boolean @default(true) @map("is_active")

  // Security (Basic)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLogin     DateTime? @map("last_failed_login") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  lastPasswordChange  DateTime? @map("last_password_change") @db.Timestamptz(6)

  // Audit
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Migration Support
  legacyId   Int?    @unique @map("legacy_id")
  legacyType String? @map("legacy_type") @db.VarChar(20)

  // Relations
  programCategory       ProgramCategory          @relation(fields: [programCategoryId], references: [id])
  identities            UserIdentity[]           // Multiple auth providers
  admin                 Admin?
  participant           Participant?
  ambassador            Ambassador?
  preferences           UserPreference?
  sessions              UserSession[]
  securityLogs          UserSecurityLog[]
  notifications         UserNotification[]
  privacyConsents       UserPrivacyConsent[]
  blockedAccounts       UserBlockedAccount[]
  activityLogs          UserActivityLog[]
  deletionRequests      AccountDeletionRequest[]
  announcementReads     UserAnnouncementRead[]
  editHistoryChangedBy  ApplicationEditHistory[] @relation("EditHistoryChangedBy")
  deletedParticipants   Participant[]            @relation("ParticipantDeleter")
  deletedApplications   ParticipantApplication[] @relation("ApplicationDeleter")
  deletedAmbassadors    Ambassador[]             @relation("AmbassadorDeleter")
  withdrawnApplications ParticipantApplication[] @relation("ApplicationWithdrawer")
  payments              Payment[]
  files                 File[]
  waitlist              ProgramWaitlist[]

  @@unique([email, programCategoryId])
  @@index([email])
  @@index([programCategoryId])
  @@index([emailVerified])
  @@index([isActive, deletedAt])
  @@index([passwordResetToken])
  @@map("users")
}

// User Authentication Identities - Supports multiple auth providers per user
model UserIdentity {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  providerId    String    @map("provider_id") @db.Uuid // Reference to AuthProvider
  providerUserId String?  @map("provider_user_id") @db.VarChar(255) // Provider's user ID (null for local)
  providerEmail String?   @map("provider_email") @db.VarChar(255) // Email from provider
  
  // OAuth tokens (optional, for future use)
  accessToken   String?   @map("access_token") @db.Text
  refreshToken  String?   @map("refresh_token") @db.Text
  tokenExpiry   DateTime? @map("token_expiry") @db.Timestamptz(6)
  
  // Metadata
  isPrimary     Boolean   @default(false) @map("is_primary") // Primary login method
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  
  // Timestamps
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  // Relations
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AuthProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  
  @@unique([userId, providerId]) // One provider per user
  @@unique([providerId, providerUserId]) // Unique provider-providerUserId combination
  @@index([userId])
  @@index([providerId])
  @@index([providerUserId])
  @@map("user_identities")
}

model ProgramCategory {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  slug        String    @unique @db.VarChar(100)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  legacyId    Int?      @unique @map("legacy_id")

  // Brand/Website Information
  websiteUrl   String? @map("website_url") @db.VarChar(255)
  about        String? @db.Text
  vision       String? @db.Text
  mission      String? @db.Text
  logoUrl      String? @map("logo_url") @db.VarChar(500)
  bannerUrl    String? @map("banner_url") @db.VarChar(500)
  primaryColor String? @map("primary_color") @db.VarChar(7) // Hex color
  
  // Contact Information
  contactEmail       String? @map("contact_email") @db.VarChar(255)
  contactPhone       String? @map("contact_phone") @db.VarChar(50)
  contactWhatsapp    String? @map("contact_whatsapp") @db.VarChar(50)
  contactAddress     String? @map("contact_address") @db.Text
  socialMediaLinks   Json?   @default("{}") @map("social_media_links") @db.Json // {instagram, facebook, linkedin, etc}
  
  // Location
  defaultLocation    String? @map("default_location") @db.VarChar(255)
  defaultCountry     String? @map("default_country") @db.VarChar(100)
  defaultTimezone    String? @map("default_timezone") @db.VarChar(50)
  
  // Settings
  requireEmailVerification Boolean @default(true) @map("require_email_verification")
  defaultCurrency          String  @default("USD") @map("default_currency") @db.VarChar(3)
  enableMultiCurrency      Boolean @default(false) @map("enable_multi_currency")
  
  // SEO
  metaTitle       String? @map("meta_title") @db.VarChar(255)
  metaDescription String? @map("meta_description") @db.Text
  metaKeywords    String? @map("meta_keywords") @db.Text

  // Relations
  testimonials ProgramTestimonial[]
  users               User[]
  programs            Program[]
  systemAnnouncements SystemAnnouncement[]
  sponsors            Sponsor[]
  emailTemplates      EmailTemplate[]
  team                ProgramTeam[]
  settings            ProgramCategorySetting?
  socialFeeds         ProgramSocialFeed[]
  activeAdmins        AdminProgramCategory[]

  @@index([slug])
  @@index([isActive])
  @@map("program_categories")
}

model ProgramCategorySetting {
  id                String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programCategoryId String          @unique @map("program_category_id") @db.Uuid
  
  // Maintenance Control
  isMaintenanceMode       Boolean     @default(false) @map("is_maintenance_mode")
  maintenanceMessage      String?     @map("maintenance_message") @db.Text
  maintenanceScheduledEnd DateTime?   @map("maintenance_scheduled_end") @db.Timestamptz(6)
  
  // Navigation & Content
  footerNavigation  Json            @default("[]") @map("footer_navigation") @db.Json // Flexible array of columns/links
  
  // Currency Settings
  usdInIdr          Decimal         @default(16000) @map("usd_in_idr") @db.Decimal(10, 2)

  // Integrations / Analytics
  googleAnalyticsId String?         @map("google_analytics_id") @db.VarChar(50)
  pixelId           String?         @map("pixel_id") @db.VarChar(50)
  supportEmail      String?         @map("support_email") @db.VarChar(255)

  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  programCategory   ProgramCategory @relation(fields: [programCategoryId], references: [id], onDelete: Cascade)

  @@map("program_category_settings")
}

model ProgramSocialFeed {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programCategoryId String   @map("program_category_id") @db.Uuid
  platform          String   @default("instagram") @db.VarChar(50) // instagram, tiktok
  postId            String   @map("post_id") @db.VarChar(100)      // External ID
  imageUrl          String   @map("image_url") @db.VarChar(500)
  permalink         String   @db.VarChar(500)
  caption           String?  @db.Text
  postedAt          DateTime @map("posted_at") @db.Timestamptz(6)
  
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  
  programCategory   ProgramCategory @relation(fields: [programCategoryId], references: [id], onDelete: Cascade)
  
  @@index([programCategoryId])
  @@index([platform])
  @@index([postedAt])
  @@map("program_social_feeds")
}

// ============================================================================
// USER PROFILES
// ============================================================================

model Admin {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Profile
  fullName    String  @map("full_name") @db.VarChar(255)
  phoneNumber String? @map("phone_number") @db.VarChar(20)
  bio         String? @db.Text
  avatarUrl   String? @map("avatar_url") @db.VarChar(500)

  // Employment
  employeeId String? @unique @map("employee_id") @db.VarChar(50)
  department String? @db.VarChar(100)
  jobTitle   String? @map("job_title") @db.VarChar(100)

  // Role & Permissions
  roleId            String? @map("role_id") @db.Uuid
  customPermissions Json    @default("[]") @map("custom_permissions")

  // Access Control
  accessLevel     Int     @default(1) @map("access_level")
  canManageAdmins Boolean @default(false) @map("can_manage_admins")
  canAssignRoles  Boolean @default(false) @map("can_assign_roles")

  // Settings
  timezone    String @default("UTC") @db.VarChar(50)
  locale      String @default("en") @db.VarChar(10)
  preferences Json   @default("{}") @db.Json

  // Audit & Timeline
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(6)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  lastActiveAt  DateTime? @map("last_active_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  deletedBy     String?   @map("deleted_by") @db.Uuid
  legacyId      Int?      @unique @map("legacy_id")

  // Relations
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                 AdminRole?               @relation(fields: [roleId], references: [id])
  adminPrograms        AdminProgram[]
  adminProgramCategories AdminProgramCategory[]
  reviewedApplications ParticipantApplication[]
  verifiedReferrals    AmbassadorReferral[]
  createdAnnouncements SystemAnnouncement[]     @relation("AnnouncementCreator")
  updatedAnnouncements SystemAnnouncement[]     @relation("AnnouncementUpdater")
  reviewedDeletions    AccountDeletionRequest[]
  blockedAccounts      UserBlockedAccount[]     @relation("BlockedBy")
  unblockedAccounts    UserBlockedAccount[]     @relation("UnblockedBy")
  deletedParticipants  Participant[]            @relation("AdminParticipantDeleter")
  deletedAmbassadors   Ambassador[]             @relation("AdminAmbassadorDeleter")

  @@index([userId])
  @@index([roleId])
  @@index([employeeId])
  @@index([department])
  @@index([deletedAt])
  @@map("admins")
}

model AdminRole {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  permissions Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  legacyId    Int?     @unique @map("legacy_id")

  // Relations
  admins Admin[]

  @@index([name])
  @@map("admin_roles")
}

model AdminProgram {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adminId   String @map("admin_id") @db.Uuid
  programId String @map("program_id") @db.Uuid

  // Access Control
  roleInProgram String? @map("role_in_program") @db.VarChar(50)
  permissions   Json    @default("[]")

  // Audit
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?   @map("assigned_by") @db.Uuid
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  removedBy  String?   @map("removed_by") @db.Uuid
  legacyId   Int?      @unique @map("legacy_id")

  // Relations
  admin   Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([adminId, programId])
  @@index([adminId])
  @@index([programId])
  @@index([removedAt])
  @@map("admin_programs")
}

model AdminProgramCategory {
  id                String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adminId           String          @map("admin_id") @db.Uuid
  programCategoryId String          @map("program_category_id") @db.Uuid

  // Access Control
  roleInBrand       String?         @map("role_in_brand") @db.VarChar(50)
  permissions       Json            @default("[]")

  // Audit
  assignedAt        DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy        String?         @map("assigned_by") @db.Uuid
  legacyId          Int?            @unique @map("legacy_id")

  // Relations
  admin             Admin           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  programCategory   ProgramCategory @relation(fields: [programCategoryId], references: [id], onDelete: Cascade)

  @@unique([adminId, programCategoryId])
  @@index([adminId])
  @@index([programCategoryId])
  @@map("admin_program_categories")
}

model Participant {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Basic Profile
  fullName    String    @map("full_name") @db.VarChar(255)
  nickName    String?   @map("nick_name") @db.VarChar(100)
  displayName String?   @map("display_name") @db.VarChar(100)
  birthdate   DateTime? @db.Date
  gender      Gender?

  // Contact Information
  phoneCountryCode String? @map("phone_country_code") @db.VarChar(10)
  phoneNumber      String? @map("phone_number") @db.VarChar(25)
  phoneVerified    Boolean @default(false) @map("phone_verified")

  // Location
  nationality     String? @db.VarChar(100)
  nationalityCode String? @map("nationality_code") @db.VarChar(3)
  originCountry   String? @map("origin_country") @db.VarChar(100)
  originCity      String? @map("origin_city") @db.VarChar(100)
  originAddress   String? @map("origin_address") @db.Text
  currentCountry  String? @map("current_country") @db.VarChar(100)
  currentCity     String? @map("current_city") @db.VarChar(100)
  currentAddress  String? @map("current_address") @db.Text

  // Education & Occupation
  educationLevel String? @map("education_level") @db.VarChar(100)
  institution    String? @db.VarChar(200)
  major          String? @db.VarChar(200)
  graduationYear Int?    @map("graduation_year")
  occupation     String? @db.VarChar(100)

  // Social & Professional
  instagramUsername String? @map("instagram_username") @db.VarChar(50)
  linkedinUrl       String? @map("linkedin_url") @db.VarChar(500)
  portfolioUrl      String? @map("portfolio_url") @db.VarChar(500)
  organizations     String? @db.Text

  // Additional Info
  tshirtSize          String? @map("tshirt_size") @db.VarChar(10)
  dietaryRestrictions String? @map("dietary_restrictions") @db.Text
  medicalConditions   String? @map("medical_conditions") @db.Text
  specialNeeds        String? @map("special_needs") @db.Text

  // Emergency Contact
  emergencyContactName        String? @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactRelation    String? @map("emergency_contact_relation") @db.VarChar(50)
  emergencyContactCountryCode String? @map("emergency_contact_country_code") @db.VarChar(10)
  emergencyContactPhone       String? @map("emergency_contact_phone") @db.VarChar(25)
  emergencyContactEmail       String? @map("emergency_contact_email") @db.VarChar(255)

  // Profile Media
  profilePictureUrl String? @map("profile_picture_url") @db.VarChar(500)
  resumeUrl         String? @map("resume_url") @db.VarChar(500)

  // Engagement
  knowledgeSource String? @map("knowledge_source") @db.VarChar(100)
  referralCode    String? @map("referral_code") @db.VarChar(20)
  preferences     Json    @default("{}") @db.Json

  // Audit & Analytics
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  profileCompletedAt          DateTime? @map("profile_completed_at") @db.Timestamptz(6)
  profileCompletionPercentage Int       @default(0) @map("profile_completion_percentage")
  lastProfileUpdate           DateTime? @map("last_profile_update") @db.Timestamptz(6)
  emailVerifiedAt             DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt             DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  deletedAt                   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy                   String?   @map("deleted_by") @db.Uuid
  legacyId                    Int?      @unique @map("legacy_id")

  // Relations
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications        ParticipantApplication[]
  ambassadorReferrals AmbassadorReferral[]
  userDeleter         User?                    @relation("ParticipantDeleter", fields: [deletedBy], references: [id], map: "fk_participant_deleted_by_user")
  adminDeleter        Admin?                   @relation("AdminParticipantDeleter", fields: [deletedBy], references: [id], map: "fk_participant_deleted_by_admin")

  @@index([userId])
  @@index([nationalityCode])
  @@index([institution])
  @@index([referralCode])
  @@index([deletedAt])
  @@map("participants")
}

model Ambassador {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Profile
  fullName    String  @map("full_name") @db.VarChar(255)
  phoneNumber String? @map("phone_number") @db.VarChar(25)

  // Ambassador Specific
  referralCode String  @unique @map("referral_code") @db.VarChar(20)
  programId    String  @map("program_id") @db.Uuid
  institution  String? @db.VarChar(255)
  gender       Gender?

  // Performance Tracking
  totalReferrals            Int       @default(0) @map("total_referrals")
  successfulReferrals       Int       @default(0) @map("successful_referrals")
  lastReferralAt            DateTime? @map("last_referral_at") @db.Timestamptz(6)
  firstSuccessfulReferralAt DateTime? @map("first_successful_referral_at") @db.Timestamptz(6)

  // Status
  notes              String?   @db.Text
  isActive           Boolean   @default(true) @map("is_active")
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz(6)
  deactivatedAt      DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivationReason String?   @map("deactivation_reason") @db.Text

  // Audit
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  legacyId  Int?      @unique @map("legacy_id")

  // Relations
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program              @relation(fields: [programId], references: [id])
  referrals    AmbassadorReferral[]
  userDeleter  User?                @relation("AmbassadorDeleter", fields: [deletedBy], references: [id], map: "fk_ambassador_deleted_by_user")

}

model SystemAnnouncement {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  // Announcement Details
  title   String  @db.VarChar(255)
  content String  @db.Text
  summary String? @db.Text

  // Targeting
  targetAudience    AnnouncementTarget @default(all) @map("target_audience")
  programCategoryId String?            @map("program_category_id") @db.Uuid
  programId         String?            @map("program_id") @db.Uuid

  // Priority & Type
  priority AnnouncementPriority @default(normal)
  type     AnnouncementType     @default(general)

  // Visibility
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  // Display Settings
  isDismissible Boolean @default(true) @map("is_dismissible")
  showBanner    Boolean @default(false) @map("show_banner")

  // Action
  actionUrl   String? @map("action_url") @db.VarChar(500)
  actionLabel String? @map("action_label") @db.VarChar(100)

  // Scheduling
  startDate DateTime? @map("start_date") @db.Timestamptz(6)
  endDate   DateTime? @map("end_date") @db.Timestamptz(6)

  // Author
  createdBy String  @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  // Metadata
  metadata Json @default("{}") @db.Json

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  programCategory ProgramCategory?       @relation(fields: [programCategoryId], references: [id])
  program         Program?               @relation(fields: [programId], references: [id], onDelete: Cascade)
  creator         Admin                  @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  updater         Admin?                 @relation("AnnouncementUpdater", fields: [updatedBy], references: [id])
  reads           UserAnnouncementRead[]

  @@index([isPublished, publishedAt, deletedAt])
  @@index([startDate, endDate, isPublished, deletedAt])
  @@index([targetAudience, programCategoryId])
  @@index([showBanner, isPublished, deletedAt])
  @@map("system_announcements")
}

model UserAnnouncementRead {
  id             String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  announcementId String @map("announcement_id") @db.Uuid

  // Tracking
  isDismissed Boolean   @default(false) @map("is_dismissed")
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz(6)

  // Timestamps
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement SystemAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId, announcementId])
  @@index([announcementId])
  @@map("user_announcement_reads")
}

model ApplicationEditHistory {

// Prisma Schema for YBB Platform
// Brand-Scoped Multi-Tenancy Architecture with Clean Architecture Principles
// Database: PostgreSQL 14+
// Last Updated: November 25, 2025

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================


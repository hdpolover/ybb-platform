// Prisma Schema for YBB Platform
// Brand-Scoped Multi-Tenancy Architecture with Clean Architecture Principles
// Database: PostgreSQL 14+
// Last Updated: November 25, 2025

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Gender {
  male
  female
  other
}

enum ApplicationCategory {
  fully_funded
  self_funded
  partial_funded
}

enum ApplicationStatus {
  draft
  submitted
  under_review
  interview_scheduled
  accepted
  rejected
  waitlisted
  withdrawn
}

enum ScoreStatus {
  pending
  scored
  go_to_interview
  rejected
}

enum ReferralStatus {
  referred
  registered
  applied
  accepted
  completed
}

enum BlockType {
  temporary
  permanent
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum NotificationPriority {
  low
  normal
  high
  urgent
}

enum AnnouncementTarget {
  all
  participants
  ambassadors
  specific_program
}

enum AnnouncementPriority {
  low
  normal
  high
  urgent
}

enum AnnouncementType {
  general
  maintenance
  deadline
  feature
  alert
}

enum DeletionStatus {
  pending
  approved
  rejected
  completed
  cancelled
}

enum Theme {
  light
  dark
  auto
}

enum ChangeType {
  create
  update
  delete
  status_change
}

enum ChangedByType {
  participant
  admin
  system
}

// ============================================================================
// CORE AUTHENTICATION (Brand-Scoped)
// ============================================================================

model User {
  id                String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email             String @db.VarChar(255)
  programCategoryId String @map("program_category_id") @db.Uuid

  // Authentication
  passwordHash             String    @map("password_hash") @db.VarChar(255)
  emailVerified            Boolean   @default(false) @map("email_verified")
  emailVerificationToken   String?   @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpires DateTime? @map("email_verification_expires") @db.Timestamptz(6)
  passwordResetToken       String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires     DateTime? @map("password_reset_expires") @db.Timestamptz(6)

  // Account Status
  isActive Boolean @default(true) @map("is_active")

  // Security (Basic)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLogin     DateTime? @map("last_failed_login") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  lastPasswordChange  DateTime? @map("last_password_change") @db.Timestamptz(6)

  // Audit
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Migration Support
  legacyId   Int?    @map("legacy_id")
  legacyType String? @map("legacy_type") @db.VarChar(20)

  // Relations
  programCategory       ProgramCategory          @relation(fields: [programCategoryId], references: [id])
  admin                 Admin?
  participant           Participant?
  ambassador            Ambassador?
  preferences           UserPreference?
  sessions              UserSession[]
  securityLogs          UserSecurityLog[]
  notifications         UserNotification[]
  privacyConsents       UserPrivacyConsent[]
  blockedAccounts       UserBlockedAccount[]
  activityLogs          UserActivityLog[]
  deletionRequests      AccountDeletionRequest[]
  announcementReads     UserAnnouncementRead[]
  editHistoryChangedBy  ApplicationEditHistory[] @relation("EditHistoryChangedBy")
  deletedParticipants   Participant[]            @relation("ParticipantDeleter")
  deletedApplications   ParticipantApplication[] @relation("ApplicationDeleter")
  deletedAmbassadors    Ambassador[]             @relation("AmbassadorDeleter")
  withdrawnApplications ParticipantApplication[] @relation("ApplicationWithdrawer")
  payments              Payment[]
  files                 File[]

  @@unique([email, programCategoryId])
  @@index([email])
  @@index([programCategoryId])
  @@index([emailVerified])
  @@index([isActive, deletedAt])
  @@index([passwordResetToken])
  @@map("users")
}

model ProgramCategory {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  slug        String    @unique @db.VarChar(100)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  legacyId    Int?      @unique @map("legacy_id")

  // Relations
  users               User[]
  programs            Program[]
  systemAnnouncements SystemAnnouncement[]

  @@index([slug])
  @@index([isActive])
  @@map("program_categories")
}

// ============================================================================
// USER PROFILES
// ============================================================================

model Admin {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Profile
  fullName    String  @map("full_name") @db.VarChar(255)
  phoneNumber String? @map("phone_number") @db.VarChar(20)
  bio         String? @db.Text
  avatarUrl   String? @map("avatar_url") @db.VarChar(500)

  // Employment
  employeeId String? @unique @map("employee_id") @db.VarChar(50)
  department String? @db.VarChar(100)
  jobTitle   String? @map("job_title") @db.VarChar(100)

  // Role & Permissions
  roleId            String? @map("role_id") @db.Uuid
  customPermissions Json    @default("[]") @map("custom_permissions")

  // Access Control
  accessLevel     Int     @default(1) @map("access_level")
  canManageAdmins Boolean @default(false) @map("can_manage_admins")
  canAssignRoles  Boolean @default(false) @map("can_assign_roles")

  // Settings
  timezone    String @default("UTC") @db.VarChar(50)
  locale      String @default("en") @db.VarChar(10)
  preferences Json   @default("{}") @db.Json

  // Audit & Timeline
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(6)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  lastActiveAt  DateTime? @map("last_active_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  deletedBy     String?   @map("deleted_by") @db.Uuid
  legacyId      Int?      @unique @map("legacy_id")

  // Relations
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                 AdminRole?               @relation(fields: [roleId], references: [id])
  adminPrograms        AdminProgram[]
  reviewedApplications ParticipantApplication[]
  verifiedReferrals    AmbassadorReferral[]
  createdAnnouncements SystemAnnouncement[]     @relation("AnnouncementCreator")
  updatedAnnouncements SystemAnnouncement[]     @relation("AnnouncementUpdater")
  reviewedDeletions    AccountDeletionRequest[]
  blockedAccounts      UserBlockedAccount[]     @relation("BlockedBy")
  unblockedAccounts    UserBlockedAccount[]     @relation("UnblockedBy")
  deletedParticipants  Participant[]            @relation("AdminParticipantDeleter")
  deletedAmbassadors   Ambassador[]             @relation("AdminAmbassadorDeleter")

  @@index([userId])
  @@index([roleId])
  @@index([employeeId])
  @@index([department])
  @@index([deletedAt])
  @@map("admins")
}

model AdminRole {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  permissions Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  legacyId    Int?     @unique @map("legacy_id")

  // Relations
  admins Admin[]

  @@index([name])
  @@map("admin_roles")
}

model AdminProgram {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  adminId   String @map("admin_id") @db.Uuid
  programId String @map("program_id") @db.Uuid

  // Access Control
  roleInProgram String? @map("role_in_program") @db.VarChar(50)
  permissions   Json    @default("[]")

  // Audit
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?   @map("assigned_by") @db.Uuid
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  removedBy  String?   @map("removed_by") @db.Uuid
  legacyId   Int?      @unique @map("legacy_id")

  // Relations
  admin   Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([adminId, programId])
  @@index([adminId])
  @@index([programId])
  @@index([removedAt])
  @@map("admin_programs")
}

model Participant {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Basic Profile
  fullName    String    @map("full_name") @db.VarChar(255)
  nickName    String?   @map("nick_name") @db.VarChar(100)
  displayName String?   @map("display_name") @db.VarChar(100)
  birthdate   DateTime? @db.Date
  gender      Gender?

  // Contact Information
  phoneCountryCode String? @map("phone_country_code") @db.VarChar(10)
  phoneNumber      String? @map("phone_number") @db.VarChar(25)
  phoneVerified    Boolean @default(false) @map("phone_verified")

  // Location
  nationality     String? @db.VarChar(100)
  nationalityCode String? @map("nationality_code") @db.VarChar(3)
  originCountry   String? @map("origin_country") @db.VarChar(100)
  originCity      String? @map("origin_city") @db.VarChar(100)
  originAddress   String? @map("origin_address") @db.Text
  currentCountry  String? @map("current_country") @db.VarChar(100)
  currentCity     String? @map("current_city") @db.VarChar(100)
  currentAddress  String? @map("current_address") @db.Text

  // Education & Occupation
  educationLevel String? @map("education_level") @db.VarChar(100)
  institution    String? @db.VarChar(200)
  major          String? @db.VarChar(200)
  graduationYear Int?    @map("graduation_year")
  occupation     String? @db.VarChar(100)

  // Social & Professional
  instagramUsername String? @map("instagram_username") @db.VarChar(50)
  linkedinUrl       String? @map("linkedin_url") @db.VarChar(500)
  portfolioUrl      String? @map("portfolio_url") @db.VarChar(500)
  organizations     String? @db.Text

  // Additional Info
  tshirtSize          String? @map("tshirt_size") @db.VarChar(10)
  dietaryRestrictions String? @map("dietary_restrictions") @db.Text
  medicalConditions   String? @map("medical_conditions") @db.Text
  specialNeeds        String? @map("special_needs") @db.Text

  // Emergency Contact
  emergencyContactName        String? @map("emergency_contact_name") @db.VarChar(255)
  emergencyContactRelation    String? @map("emergency_contact_relation") @db.VarChar(50)
  emergencyContactCountryCode String? @map("emergency_contact_country_code") @db.VarChar(10)
  emergencyContactPhone       String? @map("emergency_contact_phone") @db.VarChar(25)
  emergencyContactEmail       String? @map("emergency_contact_email") @db.VarChar(255)

  // Profile Media
  profilePictureUrl String? @map("profile_picture_url") @db.VarChar(500)
  resumeUrl         String? @map("resume_url") @db.VarChar(500)

  // Engagement
  knowledgeSource String? @map("knowledge_source") @db.VarChar(100)
  referralCode    String? @map("referral_code") @db.VarChar(20)
  preferences     Json    @default("{}") @db.Json

  // Audit & Analytics
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  profileCompletedAt          DateTime? @map("profile_completed_at") @db.Timestamptz(6)
  profileCompletionPercentage Int       @default(0) @map("profile_completion_percentage")
  lastProfileUpdate           DateTime? @map("last_profile_update") @db.Timestamptz(6)
  emailVerifiedAt             DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt             DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  deletedAt                   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy                   String?   @map("deleted_by") @db.Uuid
  legacyId                    Int?      @unique @map("legacy_id")

  // Relations
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications        ParticipantApplication[]
  ambassadorReferrals AmbassadorReferral[]
  userDeleter         User?                    @relation("ParticipantDeleter", fields: [deletedBy], references: [id], map: "fk_participant_deleted_by_user")
  adminDeleter        Admin?                   @relation("AdminParticipantDeleter", fields: [deletedBy], references: [id], map: "fk_participant_deleted_by_admin")

  @@index([userId])
  @@index([nationalityCode])
  @@index([institution])
  @@index([referralCode])
  @@index([deletedAt])
  @@map("participants")
}

model Ambassador {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Profile
  fullName    String  @map("full_name") @db.VarChar(255)
  phoneNumber String? @map("phone_number") @db.VarChar(25)

  // Ambassador Specific
  referralCode String  @unique @map("referral_code") @db.VarChar(20)
  programId    String  @map("program_id") @db.Uuid
  institution  String? @db.VarChar(255)
  gender       Gender?

  // Performance Tracking
  totalReferrals            Int       @default(0) @map("total_referrals")
  successfulReferrals       Int       @default(0) @map("successful_referrals")
  lastReferralAt            DateTime? @map("last_referral_at") @db.Timestamptz(6)
  firstSuccessfulReferralAt DateTime? @map("first_successful_referral_at") @db.Timestamptz(6)

  // Status
  notes              String?   @db.Text
  isActive           Boolean   @default(true) @map("is_active")
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz(6)
  deactivatedAt      DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivationReason String?   @map("deactivation_reason") @db.Text

  // Audit
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  legacyId  Int?      @unique @map("legacy_id")

  // Relations
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program              @relation(fields: [programId], references: [id])
  referrals    AmbassadorReferral[]
  userDeleter  User?                @relation("AmbassadorDeleter", fields: [deletedBy], references: [id], map: "fk_ambassador_deleted_by_user")
  adminDeleter Admin?               @relation("AdminAmbassadorDeleter", fields: [deletedBy], references: [id], map: "fk_ambassador_deleted_by_admin")

  @@index([userId])
  @@index([referralCode])
  @@index([programId])
  @@index([deletedAt])
  @@map("ambassadors")
}

// ============================================================================
// PAYMENTS (Lightweight Tracking - Payment Service is Source of Truth)
// ============================================================================

model Payment {
  id            String   @id @db.Uuid // Same UUID as Payment Service payment ID
  userId        String   @map("user_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  
  // Basic Payment Info
  amount      Decimal @db.Decimal(12, 2)
  currency    String  @default("IDR") @db.VarChar(3)
  status      String  @db.VarChar(50) // pending, processing, completed, failed, refunded, cancelled
  paymentType String  @map("payment_type") @db.VarChar(20) // automatic | manual
  
  // Display Info
  paymentMethod String? @map("payment_method") @db.VarChar(100) // User-friendly name (e.g., "Midtrans Credit Card", "Bank BCA Transfer")
  
  // Timestamps
  paidAt    DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Note: For detailed payment info (gateway data, proof uploads, verification),
  // query Payment Service API using this payment.id

  @@index([userId])
  @@index([applicationId])
  @@index([status])
  @@index([paymentType])
  @@map("payments")
}

model File {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  filename    String  @db.VarChar(255)
  contentType String  @map("content_type") @db.VarChar(100)
  size        BigInt
  url         String  @db.Text
  storagePath String  @map("storage_path") @db.Text
  userId      String  @map("user_id") @db.Uuid
  entityType  String? @map("entity_type") @db.VarChar(50)
  entityId    String? @map("entity_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("files")
}

// ============================================================================
// PROGRAMS & APPLICATIONS
// ============================================================================

model Program {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  programCategoryId   String    @map("program_category_id") @db.Uuid
  name                String    @db.VarChar(255)
  description         String?   @db.Text
  year                Int
  startDate           DateTime  @map("start_date") @db.Date
  endDate             DateTime  @map("end_date") @db.Date
  applicationDeadline DateTime  @map("application_deadline") @db.Timestamptz(6)
  location            String?   @db.VarChar(255)
  capacity            Int?
  isPublished         Boolean   @default(false) @map("is_published")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  legacyId            Int?      @unique @map("legacy_id")

  // Relations
  programCategory ProgramCategory          @relation(fields: [programCategoryId], references: [id])
  applications    ParticipantApplication[]
  ambassadors     Ambassador[]
  adminPrograms   AdminProgram[]
  announcements   SystemAnnouncement[]

  @@index([programCategoryId])
  @@index([year])
  @@index([isPublished])
  @@index([deletedAt])
  @@map("programs")
}

model ParticipantApplication {
  id            String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  participantId String @map("participant_id") @db.Uuid
  programId     String @map("program_id") @db.Uuid

  // Application Data
  applicationCategory ApplicationCategory? @map("application_category")
  motivationLetter    String?              @db.Text
  achievements        String?              @db.Text
  experiences         String?              @db.Text

  // Snapshot
  participantSnapshot Json? @map("participant_snapshot") @db.Json

  // Documents
  documents        Json    @default("{}") @db.Json
  twibbonLink      String? @map("twibbon_link") @db.VarChar(500)
  requirementFiles Json    @default("[]") @map("requirement_files") @db.Json

  // Payment (lightweight reference)
  paymentId     String? @map("payment_id") @db.Uuid
  paymentStatus String? @map("payment_status") @db.VarChar(50) // Cached from payments table

  // Status & Scoring
  status         ApplicationStatus @default(draft)
  scoreTotal     Decimal?          @map("score_total") @db.Decimal(5, 2)
  scoreBreakdown Json?             @map("score_breakdown") @db.Json
  scoreStatus    ScoreStatus?      @map("score_status")

  // Review
  reviewedBy    String?   @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewerNotes String?   @map("reviewer_notes") @db.Text

  // Timeline & Status Changes
  draftCreatedAt       DateTime  @default(now()) @map("draft_created_at") @db.Timestamptz(6)
  submittedAt          DateTime? @map("submitted_at") @db.Timestamptz(6)
  lastEditedAt         DateTime? @map("last_edited_at") @db.Timestamptz(6)
  underReviewAt        DateTime? @map("under_review_at") @db.Timestamptz(6)
  interviewScheduledAt DateTime? @map("interview_scheduled_at") @db.Timestamptz(6)
  acceptedAt           DateTime? @map("accepted_at") @db.Timestamptz(6)
  rejectedAt           DateTime? @map("rejected_at") @db.Timestamptz(6)
  waitlistedAt         DateTime? @map("waitlisted_at") @db.Timestamptz(6)
  withdrawnAt          DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnBy          String?   @map("withdrawn_by") @db.Uuid

  // Payment Timeline
  paymentRequestedAt DateTime? @map("payment_requested_at") @db.Timestamptz(6)
  paymentCompletedAt DateTime? @map("payment_completed_at") @db.Timestamptz(6)

  // Document Upload Tracking
  allDocumentsUploadedAt DateTime? @map("all_documents_uploaded_at") @db.Timestamptz(6)

  // Status History
  statusHistory Json @default("[]") @map("status_history") @db.Json

  // Audit
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?   @map("deleted_by") @db.Uuid
  legacyParticipantId Int?      @map("legacy_participant_id")

  // Relations
  participant Participant              @relation(fields: [participantId], references: [id], onDelete: Cascade)
  program     Program                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  reviewer    Admin?                   @relation(fields: [reviewedBy], references: [id])
  withdrawer  User?                    @relation("ApplicationWithdrawer", fields: [withdrawnBy], references: [id])
  deleter     User?                    @relation("ApplicationDeleter", fields: [deletedBy], references: [id])
  editHistory ApplicationEditHistory[]

  @@unique([participantId, programId])
  @@index([participantId])
  @@index([programId])
  @@index([status])
  @@index([applicationCategory])
  @@index([submittedAt])
  @@index([deletedAt])
  @@map("participant_applications")
}

model AmbassadorReferral {
  id            String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ambassadorId  String @map("ambassador_id") @db.Uuid
  participantId String @map("participant_id") @db.Uuid

  // Referral Status
  status ReferralStatus @default(referred)

  // Verification
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedBy String?   @map("verified_by") @db.Uuid

  // Conversion Funnel Timestamps
  referredAt         DateTime  @default(now()) @map("referred_at") @db.Timestamptz(6)
  registeredAt       DateTime? @map("registered_at") @db.Timestamptz(6)
  profileCompletedAt DateTime? @map("profile_completed_at") @db.Timestamptz(6)
  appliedAt          DateTime? @map("applied_at") @db.Timestamptz(6)
  acceptedAt         DateTime? @map("accepted_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)

  // Funnel Analytics (Calculated in application logic or database triggers)
  daysToRegister      Int? @map("days_to_register")
  daysToApply         Int? @map("days_to_apply")
  daysToAccept        Int? @map("days_to_accept")
  totalConversionDays Int? @map("total_conversion_days")

  legacyId Int? @unique @map("legacy_id")

  // Relations
  ambassador  Ambassador  @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  verifier    Admin?      @relation(fields: [verifiedBy], references: [id])

  @@unique([ambassadorId, participantId])
  @@index([ambassadorId])
  @@index([participantId])
  @@index([status])
  @@index([referredAt, acceptedAt])
  @@map("ambassador_referrals")
}


model AccountDeletionRequest {
  id     String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Request Details
  reason         String? @db.Text
  reasonCategory String? @map("reason_category") @db.VarChar(50)

  // Status
  status DeletionStatus @default(pending)

  // Processing
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes String?   @map("review_notes") @db.Text

  // Retention Period
  scheduledDeletionDate DateTime? @map("scheduled_deletion_date") @db.Timestamptz(6)
  actualDeletionDate    DateTime? @map("actual_deletion_date") @db.Timestamptz(6)

  // Audit Trail
  dataSnapshot Json? @map("data_snapshot") @db.Json
  deletionLog  Json  @default("{}") @map("deletion_log") @db.Json

  // Metadata
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer Admin? @relation(fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status, createdAt])
  @@index([scheduledDeletionDate])

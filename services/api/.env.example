# Database
DATABASE_URL="postgresql://ybb_user:ybb_password@localhost:5432/ybb_platform?schema=public"

# Database Read Replica (Optional - for read operation scaling)
# When configured, read-only queries will be automatically routed to the replica
# Falls back to primary database if replica is unavailable
READ_REPLICA_URL="postgresql://ybb_user:ybb_password@localhost:5433/ybb_platform?schema=public"

# Circuit Breaker Configuration (Optional - defaults shown)
# Protects against cascade failures during database outages
# CIRCUIT_BREAKER_FAILURE_THRESHOLD: Number of consecutive failures before circuit opens (default: 5)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_SUCCESS_THRESHOLD: Number of successful requests to close circuit from half-open (default: 3)
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
# CIRCUIT_BREAKER_TIMEOUT: Milliseconds before attempting to close circuit (default: 60000 = 60 seconds)
CIRCUIT_BREAKER_TIMEOUT=60000

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# API
PORT=3000
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3001"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"

# Image Processing (ImageKit)
IMAGEKIT_ID="your_imagekit_id" # e.g. "ybb_platform"
STORAGE_PUBLIC_URL="https://cdn.ybbhub.com" # or your S3/Spaces endpoint

# External Services
FILE_SERVICE_URL="http://localhost:8001"
# gRPC URL (Optional if running in docker network)
FILE_GRPC_URL="http://file-service:50052"
PAYMENT_SERVICE_URL="http://localhost:8002"
PAYMENT_SERVICE_INTERNAL_KEY="replace-with-shared-service-key"

# Stripe (for Payment Service)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@ybbplatform.com"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:3001"

# Firebase Admin SDK (Use JSON)
FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# Firebase Client SDK Configuration
FIREBASE_API_KEY=AIzaSyBiQqRLe1tnbqOPsadNuoNQUtAPHiJGrCY
# ...
FIREBASE_MEASUREMENT_ID=G-79HMSYF23Y

# Logging
ENABLE_LOKI=false
ENABLE_TRACING=false
LOKI_URL=http://host.docker.internal:3110
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_LOG_LEVEL=info

{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "webpack": false,
    "deleteOutDir": true,
    "assets": [
      {
        "include": "src/**/*.proto",
        "watchAssets": true,
        "outDir": "dist"
      },
      {
        "include": "src/docs/*.md",
        "watchAssets": true
      }
    ]
  }
}

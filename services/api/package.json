{
  "name": "@ybb-platform/api",
  "version": "1.0.0",
  "description": "YBB Platform API Gateway",
  "author": "YBB Platform Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "jest --config ./test/jest-integration.json",
    "migration:run": "npx prisma migrate deploy",
    "seed:prod": "npm run build:seed && node dist/prisma/seeds/main-prod.js",
    "seed:prod:submission-config": "npm run build:seed && node dist/prisma/seeds/main-prod-submission-config.js",
    "build:seed": "tsc --project tsconfig.seed.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seeds/main.ts",
    "seed:reference": "ts-node prisma/seeds/seed-reference.ts",
    "seed:reference:prod": "node dist/prisma/seeds/seed-reference.js",
    "prisma:migrate:remote": "ts-node prisma/seeds/internal/run-remote-migration.ts",
    "prisma:reset": "prisma migrate reset",
    "landing:snapshots:backfill": "ts-node -r tsconfig-paths/register src/scripts/backfill-landing-snapshots.ts",
    "migrate:form-field-catalog": "ts-node -r tsconfig-paths/register prisma/migration-scripts/migrate-form-field-catalog.ts",
    "migrate:submission-form-normalization": "ts-node -r tsconfig-paths/register prisma/migration-scripts/migrate-submission-form-normalization.ts",
    "migrate:remove-cys-2026-legacy-essays": "node prisma/migration-scripts/remove-cys-2026-legacy-essays.js",
    "report:non-english-names": "ts-node -r tsconfig-paths/register prisma/migration-scripts/report-non-english-names.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@keyv/redis": "^4.0.3",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.20",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^7.1.17",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.55.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/form-data": "^2.2.1",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "country-state-city": "^3.2.1",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.4",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.6.0",
    "form-data": "^4.0.5",
    "geoip-lite": "^1.4.10",
    "ioredis": "^5.8.2",
    "keyv": "^5.2.3",
    "mysql2": "^3.16.3",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.17.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cache-manager": "^4.0.6",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.6",
    "@types/passport-jwt": "^4.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "prisma": "^7.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@common/(.*)$": "<rootDir>/common/$1"
    }
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "npx ts-node prisma/seeds/main.ts"
  },
  "overrides": {
    "inflight": "npm:@aashutoshrathi/inflight@^1.0.0",
    "rimraf": "^6.0.0",
    "glob": "^13.0.0",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@^0.19.0",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@^2.1.0"
  }
}

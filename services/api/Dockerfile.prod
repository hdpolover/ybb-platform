# Build Stage
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache openssl

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .
COPY . .
RUN npx prisma generate
RUN npm run build
RUN npm run build:seed

# Production Stage
FROM node:20-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

RUN apk add --no-cache openssl curl

COPY package*.json ./

# Copy node_modules from builder and prune dev dependencies
# This avoids a second network-heavy npm install in the production stage
COPY --from=builder /app/node_modules ./node_modules
RUN npm prune --production

COPY --from=builder /app/dist ./dist
# Copy prisma schema if it exists in expected location for generating client
COPY --from=builder /app/prisma ./prisma

# Generate Prisma Client (if needed at runtime, otherwise run in build)
RUN npx prisma generate

CMD ["node", "dist/src/main"]

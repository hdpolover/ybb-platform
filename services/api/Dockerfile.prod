# Build Stage
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache openssl

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .
RUN DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" npx prisma generate
RUN npm run build
RUN npm run build:seed

# Production Stage
FROM node:20-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

RUN apk add --no-cache openssl curl

COPY package*.json ./

# Copy node_modules from builder and prune dev dependencies
# This avoids a second network-heavy npm install in the production stage
COPY --from=builder /app/node_modules ./node_modules
RUN npm prune --production

COPY --from=builder /app/dist ./dist
# Ensure proto files are copied to dist
RUN mkdir -p dist/src/protos && cp -r dist/src/protos || true
COPY --from=builder /app/src/protos ./dist/src/protos
RUN mkdir -p dist/src/common/proto
COPY --from=builder /app/src/common/proto ./dist/src/common/proto


# Copy prisma schema if it exists in expected location for generating client
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts

# Update package.json to use compiled seed script in production
RUN sed -i 's/"seed": ".*"/"seed": "node dist\/prisma\/seed.js"/g' package.json

# Generate Prisma Client (if needed at runtime, otherwise run in build)
RUN DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" npx prisma generate

# Copy entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

# Use entrypoint to run migrations before starting app
ENTRYPOINT ["/bin/sh", "/docker-entrypoint.sh"]
CMD ["node", "dist/src/main"]

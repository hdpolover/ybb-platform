# Build Stage
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Production Stage
FROM node:20-alpine AS production

WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --only=production

COPY --from=builder /app/dist ./dist
# Copy prisma schema if it exists in expected location for generating client
COPY --from=builder /app/prisma ./prisma

# Generate Prisma Client (if needed at runtime, otherwise run in build)
RUN npx prisma generate

CMD ["node", "dist/main"]

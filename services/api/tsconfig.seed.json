{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "commonjs",
    "target": "ES2021",
    "moduleResolution": "node",
    "outDir": "./dist/prisma/seeds",
    "rootDir": "./prisma/seeds",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["prisma/seeds/**/*.ts"],
  "exclude": ["node_modules", "prisma/seeds/**/*.spec.ts"]
}

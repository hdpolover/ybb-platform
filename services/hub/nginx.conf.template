# services/hub/nginx.conf.template  (envsubst fills ${HUB_BRANDS_UPSTREAM} at container start)
proxy_cache_path /var/cache/nginx/brands levels=1 keys_zone=brands:1m max_size=1m inactive=1h;

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

  location = /healthz {
    default_type text/plain;
    return 200 'ok';
  }

  # Same-origin proxy: the API sends no CORS headers.
  location = /api/brands {
    proxy_pass ${HUB_BRANDS_UPSTREAM};
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header Accept application/json;
    proxy_cache brands;
    proxy_cache_valid 200 5m;
    proxy_cache_use_stale error timeout updating http_502 http_503 http_504;
    proxy_cache_lock on;
    proxy_connect_timeout 5s;
    proxy_read_timeout 10s;
    expires 60s;
  }

  location ~* \.(js|css)$ {
    expires 5m;
    try_files $uri =404;
  }

  # The path is the input, so every unknown path serves the app.
  location / {
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}

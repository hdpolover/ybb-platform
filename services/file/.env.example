# MinIO Configuration (DigitalOcean Spaces - Dev/Staging Shared)
# Endpoint: sgp1.digitaloceanspaces.com (without bucket)
MINIO_ENDPOINT=sgp1.digitaloceanspaces.com
MINIO_ACCESS_KEY=your_do_access_key
MINIO_SECRET_KEY=your_do_secret_key
# Bucket: ybb-assets-dev (Shared for Dev & Staging)
MINIO_BUCKET=ybb-assets-dev
MINIO_SECURE=true
MINIO_REGION=sgp1

# Public Endpoint (CDN or Direct)
# Example: https://ybb-assets-dev.sgp1.digitaloceanspaces.com
MINIO_PUBLIC_ENDPOINT=sgp1.digitaloceanspaces.com
MINIO_PUBLIC_SECURE=true

# --- OFFLINE DEV ONLY (MinIO Local) ---
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=ybb-files-local
# MINIO_SECURE=false
# MINIO_PUBLIC_ENDPOINT=localhost:9000
# MINIO_PUBLIC_SECURE=false


# PostgreSQL Configuration
DATABASE_URL=postgresql://ybb_user:ybb_password@postgres:5432/ybb_files_db

# Service Configuration
SERVICE_PORT=8001

# Certificate Configuration
CERTIFICATE_SIGNING_KEY=your-secret-signing-key
CERTIFICATE_VERIFICATION_URL=https://verify.ybb.org

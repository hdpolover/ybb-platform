# File Service Environment (Example)
SERVICE_PORT=8001
PYTHON_ENV=development

# Database
DATABASE_USER=ybb_user
DATABASE_PASSWORD=ybb_password
DATABASE_NAME=ybb_files_db
DATABASE_URL=postgresql://ybb_user:ybb_password@postgres-file:5432/ybb_files_db

# MinIO / DigitalOcean Spaces
# Endpoint: Region endpoint (e.g. sgp1.digitaloceanspaces.com)
MINIO_ENDPOINT=sgp1.digitaloceanspaces.com
MINIO_REGION=sgp1
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
# Shared Bucket Name
MINIO_BUCKET=ybb
MINIO_SECURE=true

# Public Endpoint configuration
# Use 'cdn.ybbhub.com' if configured, or the Spaces endpoint
MINIO_PUBLIC_ENDPOINT=cdn.ybbhub.com
MINIO_PUBLIC_SECURE=true

# Domain Rule (for Traefik/Dokploy)
# APP_DOMAINS_RULE=Host(`files.ybbhub.com`)

# Payment Service Configuration

# Server
PORT=8002
ENVIRONMENT=development
GIN_MODE=debug

# Database (Separate database for payment service)
DATABASE_URL=postgresql://ybb_user:ybb_pass@postgres:5432/ybb_payments_db

# RabbitMQ (for event publishing)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=payment-events

# Default automatic provider fallback.
# Preferred source of truth is payment_methods.gateway_name; use this only if a method leaves it empty.
DEFAULT_PAYMENT_GATEWAY=midtrans

# Internal auth shared key for private HTTP and gRPC calls.
# Required for non-local environments (e.g., staging, production).
INTERNAL_SERVICE_KEY=

# Gateway credential encryption key (required for gateway config CRUD).
# Generate with: openssl rand -base64 32
PAYMENT_SECRETS_KEY=

# Midtrans Configuration
MIDTRANS_SERVER_KEY=your-server-key
MIDTRANS_CLIENT_KEY=your-client-key
MIDTRANS_IS_PRODUCTION=false

# Optional gateway providers. Register only the ones you configure.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# Observability
LOKI_URL=http://host.docker.internal:3100
# Optional. Leave empty to disable OTLP trace export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_LOG_LEVEL=info

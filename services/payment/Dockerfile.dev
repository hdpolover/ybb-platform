# Development Dockerfile
FROM golang:1.24-alpine

WORKDIR /app

# Install git then air
RUN apk add --no-cache git && \
    go install github.com/air-verse/air@v1.61.0

# Copy source code
COPY . .

# Ensure dependencies are tidy and downloaded
# Ensure dependencies are tidy and downloaded with retries
RUN go env -w GOPROXY=https://proxy.golang.org,direct && \
    (go mod tidy && go mod download || go mod tidy && go mod download || go mod tidy && go mod download)

# Explicitly Copy migrations to /app/migrations to ensure they exist even if volume fails
COPY migrations ./migrations

# Expose port
EXPOSE 8002

# Run directly with go run (hot reload disabled for compatibility)
CMD ["go", "run", "cmd/server/main.go"]
